# Packages this repo's own tooling needs on macOS.
#
# Not listed, by design:
#   git, clang   - come from the Xcode Command Line Tools (xcode-select --install)
#   dotnet, dotnetup, roslynk, aspire - handled by ./setup.sh
#   dash         - macOS already ships /bin/dash
#
# Refresh with: ./update.sh --brew

brew "shellcheck" # CI lints every shell script with it; not installed by default
