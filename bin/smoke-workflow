#!/usr/bin/env python3
"""Smoke-test the default OpenCode workflow.

Creates a throwaway git repo under $OPENCODE_TMP, runs four prompts through the
default agent, and checks:
  - the agent announces the expected tier;
  - it launches the expected fixed-model subagents;
  - it does not launch the wrong tier's agents;
  - the second-opinion prompt does not contain the review-deep report marker;
  - the repo's test.sh passes and the expected output contract holds;
  - on the C# repo, it opens the solution with Roslynk before editing, and uses
    Roslynk navigation rather than grep for the rename.

The C# case is the only one that needs the .NET SDK and the Roslynk MCP server.
It runs against its own scratch repo (`smoke-workflow-cs`) and asserts tool
choice, so it fails when the global Roslynk policy stops being followed. It
forbids delegation because `opencode run --format json` reports only the main
session's tool calls; a child session's Roslynk calls are invisible to it.

Run it before the workflow change (it should fail) and after (it should pass).

    ./smoke-workflow
    ./smoke-workflow --timeout 1200
"""

from __future__ import annotations

import argparse
import json
import os
import re
import shutil
import subprocess
import sys
import time

# See bin/review-bundle: a literal /private/var path is macOS-only.
DEFAULT_TMP = os.path.join(os.environ.get("TMPDIR") or "/tmp", "opencode")
REVIEW_DEEP_MARKER = "REVIEW-DEEP REPORT"

T0 = (
    "Fix the typo in README.md: change 'helo' to 'hello'. "
    "Do not change anything else."
)
T1 = (
    "Add a `--upper` flag to hello.sh. With `--upper`, the greeting is "
    "uppercased. Update test.sh to cover it. Keep the default output unchanged."
)
T2 = (
    "Change hello.sh's output contract from `Hello, NAME!` to `Hello NAME` "
    "(no comma, no exclamation). With `--upper`, produce `HELLO NAME`. "
    "Update caller.sh and test.sh. This is a public output contract change."
)
CS = (
    "Rename `Greeter.Greet` to `Greeter.Say` everywhere in Smoke.slnx, keeping "
    "behaviour identical. Update every caller, then confirm the solution compiles. "
    "Do not delegate this edit to a subagent; make it yourself."
)

# Read-only Roslynk operations that demonstrate semantic navigation. `get_diagnostics`
# is deliberately excluded: it proves the solution loaded but does not use symbol
# information, so letting it satisfy the assertion would green-light an agent that
# opened the solution and then hand-edited from grep.
ROSLYNK_SEMANTIC = {
    "roslynk_search_symbols",
    "roslynk_find_definition",
    "roslynk_find_references",
    "roslynk_get_members",
    "roslynk_get_symbol_body",
    "roslynk_get_callers",
    "roslynk_get_callees",
    "roslynk_find_implementations",
    "roslynk_get_expression_info",
    "roslynk_multi_query",
}
ROSLYNK_WRITE = {"roslynk_rename_symbol", "roslynk_change_signature", "roslynk_apply_patch"}
# A write through Roslynk is the ideal shape for this case (a semantic rename), so
# it satisfies the semantic assertion too. Anything that modifies a file counts as
# the edit that open_solution must precede.
ROSLYNK_USED = ROSLYNK_SEMANTIC | ROSLYNK_WRITE
EDITS = {"edit", "write", "patch", "multiedit"} | ROSLYNK_WRITE
CS_SUFFIXES = (".cs", ".razor", ".cshtml", ".csproj", ".sln", ".slnx")


def run(args: list[str], cwd: str | None = None, timeout: int = 120) -> subprocess.CompletedProcess:
    env = None
    if cwd:
        env = dict(os.environ)
        env["PWD"] = cwd
    return subprocess.run(args, cwd=cwd, capture_output=True, text=True, env=env, timeout=timeout)


def write(path: str, body: str, mode: int = 0o644) -> None:
    with open(path, "w") as handle:
        handle.write(body)
    os.chmod(path, mode)


def setup_repo(root: str) -> None:
    if os.path.exists(root):
        shutil.rmtree(root)
    os.makedirs(root)
    write(os.path.join(root, "README.md"), "# Smoke repo\n\nhelo world\n")
    write(
        os.path.join(root, "hello.sh"),
        '#!/usr/bin/env bash\nset -euo pipefail\nname="${1:-World}"\n'
        'printf \'Hello, %s!\\n\' "$name"\n',
        0o755,
    )
    write(
        os.path.join(root, "caller.sh"),
        '#!/usr/bin/env bash\nset -euo pipefail\n./hello.sh "$1"\n',
        0o755,
    )
    write(
        os.path.join(root, "test.sh"),
        '#!/usr/bin/env bash\nset -euo pipefail\n'
        'out="$(./hello.sh World)"\n'
        '[[ "$out" == "Hello, World!" ]] || { echo "unexpected: $out"; exit 1; }\n'
        'echo ok\n',
        0o755,
    )
    write(os.path.join(root, "AGENTS.md"), "# Smoke repo\n\n- Build: none\n- Test: ./test.sh\n")
    for args in (
        ["git", "init", "-q"],
        ["git", "config", "user.email", "smoke@example.invalid"],
        ["git", "config", "user.name", "Smoke"],
        ["git", "add", "-A"],
        ["git", "commit", "-qm", "baseline"],
    ):
        result = run(args, cwd=root)
        if result.returncode != 0:
            raise SystemExit(f"git failed: {' '.join(args)}\n{result.stderr}")


def setup_cs_repo(root: str) -> None:
    """Build a two-project C# solution so the Roslynk case has something to load."""
    if os.path.exists(root):
        shutil.rmtree(root)
    os.makedirs(os.path.join(root, "Smoke"))
    os.makedirs(os.path.join(root, "Smoke.App"))
    write(
        os.path.join(root, "Smoke.slnx"),
        '<Solution>\n'
        '  <Project Path="Smoke/Smoke.csproj" />\n'
        '  <Project Path="Smoke.App/Smoke.App.csproj" />\n'
        '</Solution>\n',
    )
    write(
        os.path.join(root, "Smoke", "Smoke.csproj"),
        '<Project Sdk="Microsoft.NET.Sdk">\n'
        '  <PropertyGroup>\n'
        '    <TargetFramework>net10.0</TargetFramework>\n'
        '    <Nullable>enable</Nullable>\n'
        '    <ImplicitUsings>enable</ImplicitUsings>\n'
        '  </PropertyGroup>\n'
        '</Project>\n',
    )
    write(
        os.path.join(root, "Smoke", "Greeter.cs"),
        'namespace Smoke;\n\npublic sealed class Greeter\n{\n'
        '    public string Greet(string name) => $"Hello, {name}!";\n}\n',
    )
    write(
        os.path.join(root, "Smoke", "App.cs"),
        'namespace Smoke;\n\npublic static class App\n{\n'
        '    public static string Run(string name) => new Greeter().Greet(name);\n}\n',
    )
    write(
        os.path.join(root, "Smoke.App", "Smoke.App.csproj"),
        '<Project Sdk="Microsoft.NET.Sdk">\n'
        '  <PropertyGroup>\n'
        '    <OutputType>Exe</OutputType>\n'
        '    <TargetFramework>net10.0</TargetFramework>\n'
        '    <Nullable>enable</Nullable>\n'
        '    <ImplicitUsings>enable</ImplicitUsings>\n'
        '  </PropertyGroup>\n'
        '  <ItemGroup>\n'
        '    <ProjectReference Include="../Smoke/Smoke.csproj" />\n'
        '  </ItemGroup>\n'
        '</Project>\n',
    )
    write(
        os.path.join(root, "Smoke.App", "Program.cs"),
        'using Smoke;\n\n'
        'var actual = App.Run("World");\n'
        'Console.WriteLine(actual);\n'
        'return actual == "Hello, World!" ? 0 : 1;\n',
    )
    write(
        os.path.join(root, "AGENTS.md"),
        "# Smoke C# repo\n\n"
        "- Build: dotnet build Smoke.slnx\n"
        "- Test: dotnet run --project Smoke.App\n",
    )
    for args in (
        ["git", "init", "-q"],
        ["git", "config", "user.email", "smoke@example.invalid"],
        ["git", "config", "user.name", "Smoke"],
        ["git", "add", "-A"],
        ["git", "commit", "-qm", "baseline"],
    ):
        result = run(args, cwd=root)
        if result.returncode != 0:
            raise SystemExit(f"git failed: {' '.join(args)}\n{result.stderr}")


def reset_repo(root: str) -> None:
    for args in (["git", "reset", "--hard", "-q", "HEAD"], ["git", "clean", "-fdq"]):
        result = run(args, cwd=root)
        if result.returncode != 0:
            raise SystemExit(f"git failed: {' '.join(args)}\n{result.stderr}")


def parse_output(raw: str) -> tuple[str, list[dict]]:
    texts: list[str] = []
    calls: list[dict] = []
    for line in raw.splitlines():
        line = line.strip()
        if not line:
            continue
        try:
            event = json.loads(line)
        except json.JSONDecodeError:
            continue
        kind = event.get("type")
        part = event.get("part", {})
        if kind == "text":
            texts.append(part.get("text", ""))
        elif kind == "tool_use":
            calls.append(
                {
                    "tool": part.get("tool"),
                    "input": part.get("state", {}).get("input", {}) or {},
                    "sessionID": event.get("sessionID"),
                }
            )
    return "\n".join(texts), calls


def subagents(calls: list[dict]) -> list[dict]:
    found = []
    for call in calls:
        if call["tool"] in ("subagent", "task"):
            found.append(
                {
                    "agent": call["input"].get("agent"),
                    "prompt": call["input"].get("prompt", ""),
                    "sessionID": call["sessionID"],
                }
            )
    return found


def announced_tier(raw: str) -> str | None:
    """Return the first tier line before the first edit or subagent call.

    A short read-only look at the repo is allowed before classification. A
    tentative wrong tier before the real one is not: the first tier line wins.
    """
    lines: list[str] = []
    for line in raw.splitlines():
        line = line.strip()
        if not line:
            continue
        try:
            event = json.loads(line)
        except json.JSONDecodeError:
            continue
        kind = event.get("type")
        part = event.get("part", {})
        if kind == "tool_use":
            tool = part.get("tool")
            if tool in ("subagent", "task", "edit", "write", "patch"):
                break
        elif kind == "text":
            lines.extend(part.get("text", "").splitlines())
    for line in lines:
        match = re.match(
            r"^\s*(?:\*\*)?tier(?:\*\*)?\s*[:\-]\s*(?:\*\*)?(T[012])\b",
            line,
            re.I,
        )
        if match:
            return match.group(1).upper()
    return None


def run_prompt(root: str, prompt: str, timeout: int) -> tuple[subprocess.CompletedProcess, str, list[dict], str | None]:
    result = run(
        ["opencode", "run", "--standalone", "--format", "json", "--auto", prompt],
        cwd=root,
        timeout=timeout,
    )
    text, calls = parse_output(result.stdout)
    return result, text, calls, announced_tier(result.stdout)


def check_t0(root: str) -> tuple[bool, str]:
    readme = open(os.path.join(root, "README.md")).read()
    if "helo" in readme:
        return False, "README still contains 'helo'"
    if "hello" not in readme:
        return False, "README does not contain 'hello'"
    return True, "README fixed"


def check_t1(root: str) -> tuple[bool, str]:
    result = run(["./hello.sh", "--upper", "World"], cwd=root)
    if result.returncode != 0:
        return False, f"--upper failed: {result.stderr.strip()}"
    if result.stdout.strip() != "HELLO, WORLD!":
        return False, f"--upper output {result.stdout.strip()!r} != 'HELLO, WORLD!'"
    return True, "--upper output ok"


def check_t2(root: str) -> tuple[bool, str]:
    result = run(["./hello.sh", "World"], cwd=root)
    if result.returncode != 0:
        return False, f"default output failed: {result.stderr.strip()}"
    if result.stdout.strip() != "Hello World":
        return False, f"default output {result.stdout.strip()!r} != 'Hello World'"
    result = run(["./hello.sh", "--upper", "World"], cwd=root)
    if result.returncode != 0:
        return False, f"--upper failed: {result.stderr.strip()}"
    if result.stdout.strip() != "HELLO WORLD":
        return False, f"--upper output {result.stdout.strip()!r} != 'HELLO WORLD'"
    return True, "output contract ok"


def check_cs(root: str) -> tuple[bool, str]:
    """Assert the rename landed. The output contract is checked by the test command."""
    source = open(os.path.join(root, "Smoke", "Greeter.cs")).read()
    if "Greet(" in source:
        return False, "Greeter.Greet was not renamed"
    if "Say(" not in source:
        return False, "renamed member is not Say"
    return True, "renamed"


def is_cs_edit(call: dict) -> bool:
    """True when this call changes a C# source, project or solution file."""
    if call.get("tool") in ROSLYNK_WRITE:
        return True
    if call.get("tool") not in EDITS:
        return False
    path = (call.get("input") or {}).get("filePath") or ""
    return path.endswith(CS_SUFFIXES)


def check_roslynk(calls: list[dict]) -> tuple[bool, str]:
    """Assert every session that edited C# opened the solution first.

    This is the only case that checks tool choice rather than a result: the
    policy says C# work starts with open_solution.

    The CS prompt forbids delegating because `opencode run --format json` emits
    only the main session's tool_use events: a child session's calls never reach
    the stream (verified by probe). Attribution is still per session so that a
    future harness that does include children is judged correctly, and so that a
    non-C# write (a plan, notes) is not mistaken for the C# edit.
    """
    tools = [call["tool"] for call in calls if call.get("tool")]
    if "roslynk_open_solution" not in tools:
        return False, f"never called roslynk_open_solution (tools: {sorted(set(tools))})"

    editors: dict[object, list[dict]] = {}
    for call in calls:
        if is_cs_edit(call):
            editors.setdefault(call.get("sessionID"), []).append(call)
    if not editors:
        return False, (
            "no C# edit in the visible session stream; cannot judge tool choice "
            f"(tools: {sorted(set(tools))})"
        )
    if None in editors:
        return False, "C# edits carry no sessionID; cannot attribute tool choice"

    used: set[str] = set()
    for session, own in editors.items():
        stream = [call for call in calls if call.get("sessionID") == session]
        names = [call["tool"] for call in stream]
        if "roslynk_open_solution" not in names:
            return False, "a session edited C# without opening the solution"
        first_edit = min(index for index, call in enumerate(stream) if call in own)
        if names.index("roslynk_open_solution") > first_edit:
            return False, "opened the solution after the first C# edit"
        semantic = {name for name in names if name in ROSLYNK_USED}
        if not semantic:
            return False, "opened the solution but used no Roslynk operation for the C# edit"
        used |= semantic
    return True, f"roslynk: {', '.join(sorted(used))}"


def check_case(
    root: str,
    name: str,
    prompt: str,
    expected_tier: str | None,
    expected_agents: list[str],
    forbidden_agents: list[str],
    extra_check,
    timeout: int,
    test: list[str] | None = None,
    calls_check=None,
) -> bool:
    reset_repo(root)
    result, text, calls, tier = run_prompt(root, prompt, timeout)
    agents = [agent["agent"] for agent in subagents(calls)]
    problems: list[str] = []

    if result.returncode != 0:
        problems.append(f"opencode exit {result.returncode}: {result.stderr.strip()[-500:]}")
    if expected_tier is not None and tier != expected_tier:
        problems.append(f"tier {tier!r} != {expected_tier!r}")
    for agent in expected_agents:
        if agent not in agents:
            problems.append(f"missing subagent {agent!r}; saw {agents}")
    for agent in forbidden_agents:
        if agent in agents:
            problems.append(f"unexpected subagent {agent!r}")

    for child in subagents(calls):
        if child["agent"] == "second-opinion" and REVIEW_DEEP_MARKER in child["prompt"]:
            problems.append("second-opinion prompt contains the review-deep report marker")

    tool_detail = "-"
    if calls_check is not None:
        tool_ok, tool_detail = calls_check(calls)
        if not tool_ok:
            problems.append(tool_detail)

    check = run(test or ["./test.sh"], cwd=root, timeout=300)
    if check.returncode != 0:
        problems.append(f"{' '.join(test or ['./test.sh'])} failed: {(check.stdout + check.stderr).strip()[-500:]}")
    ok, detail = extra_check(root)
    if not ok:
        problems.append(detail)

    print(f"== {name} ==")
    print(f"   tier:   {tier!r} (expected {expected_tier!r})")
    print(f"   agents: {agents}")
    print(f"   test:   {'ok' if check.returncode == 0 else 'FAIL'}")
    print(f"   extra:  {detail}")
    if calls_check is not None:
        print(f"   tools:  {tool_detail}")
    if problems:
        for problem in problems:
            print(f"   FAIL:   {problem}")
        if text:
            print(f"   text:   {text.strip()[:600]}")
        return False
    print("   PASS")
    return True


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--timeout", type=int, default=900, help="seconds per prompt")
    parser.add_argument(
        "--case",
        action="append",
        choices=["T0", "T1", "T2", "CS"],
        help="run only the named case; repeatable",
    )
    parser.add_argument("--root", default=os.path.join(
        os.environ.get("OPENCODE_TMP", DEFAULT_TMP), "smoke-workflow"
    ))
    args = parser.parse_args()

    temp_root = os.path.realpath(os.environ.get("OPENCODE_TMP", DEFAULT_TMP))
    root = os.path.realpath(args.root)
    base = os.path.join(temp_root, "smoke-workflow")
    if root != base and not root.startswith(base + "-") and not root.startswith(base + os.sep):
        parser.error("--root must be the smoke-workflow directory under OPENCODE_TMP")
    args.root = root

    if not shutil.which("opencode"):
        print("opencode is not on PATH", file=sys.stderr)
        return 2

    print(f"smoke repo: {args.root}")
    setup_repo(args.root)
    started = time.time()
    selected = set(args.case or ["T0", "T1", "T2", "CS"])
    cs_root = args.root + "-cs"
    needs_dotnet = "CS" in selected
    if needs_dotnet:
        if not shutil.which("dotnet"):
            print("dotnet is not on PATH (needed for the CS case)", file=sys.stderr)
            return 2
        print(f"smoke C# repo: {cs_root}")
        setup_cs_repo(cs_root)
    cases = [
        (args.root, "T0", T0, "T0", [], [
            "plan-review-deep", "review-light", "review-deep",
            "second-opinion", "implement-deep",
        ], check_t0, None),
        (args.root, "T1", T1, "T1", ["review-light"], [
            "plan-review-deep", "review-deep", "second-opinion", "implement-deep",
        ], check_t1, None),
        (args.root, "T2", T2, "T2",
         ["plan-review-deep", "implement-deep", "review-deep", "second-opinion"],
         ["review-light"], check_t2, None),
        (cs_root, "CS", CS, None, [], [], check_cs, check_roslynk),
    ]
    results = [
        check_case(
            root, name, prompt, expected_tier, expected_agents,
            forbidden_agents, extra_check, args.timeout,
            test=([ "dotnet", "run", "--project", "Smoke.App" ] if name == "CS" else None),
            calls_check=calls_check,
        )
        for root, name, prompt, expected_tier, expected_agents, forbidden_agents,
        extra_check, calls_check in cases
        if name in selected
    ]
    elapsed = int(time.time() - started)
    print(f"\n{sum(results)}/{len(results)} cases passed in {elapsed}s")
    return 0 if all(results) else 1


if __name__ == "__main__":
    sys.exit(main())
