#!/usr/bin/env python3
"""Set up the Grok Bot webhook callbacks used by notify-bot.

    setup-bot-webhooks                 # prompt for each bot
    setup-bot-webhooks --check         # show what is configured, no prompts
    setup-bot-webhooks --non-interactive   # read <BOT>_WEBHOOK_URL/AUTH from the environment

A blank answer keeps the existing value; on a first run it skips that bot. The
authorization prompt is hidden on a terminal. Values are written to
$BOT_WEBHOOKS_ENV, default ~/.config/bot-webhooks/env, with mode 0600. A
non-default path is for tests: notify-bot always reads the default path, so a
custom --env is not a deployment. The file is sourced by the shell rc files
through one managed block, never by a second copy of the values. Nothing here
prints a URL or an authorization value.
"""
from __future__ import annotations

import argparse
import getpass
import importlib.machinery
import importlib.util
import os
import re
import sys
import tempfile
from pathlib import Path
from urllib.parse import urlsplit

HERE = Path(__file__).resolve().parent
BEGIN = "# BEGIN bot-webhooks (managed by bin/setup-bot-webhooks)"
END = "# END bot-webhooks"


def load_notify():
    loader = importlib.machinery.SourceFileLoader("notify_bot", str(HERE / "notify-bot"))
    spec = importlib.util.spec_from_loader(loader.name, loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    return module


notify = load_notify()


class EndOfInput(Exception):
    """The person stopped typing (Ctrl-D), or the input was a closed pipe."""


def shell_quote(value: str) -> str:
    return "'" + value.replace("'", "'\\''") + "'"


def url_error(url: str) -> str | None:
    try:
        return notify.url_problem(url)
    except ValueError:
        return "invalid URL"


def bot_names(values: dict[str, str]) -> list[str]:
    """Bots the file names, in file order (the same rule as notify-bot's bots())."""
    names: list[str] = []
    for key in values:
        match = notify.BOT_KEY.fullmatch(key)
        if match and match.group(1) not in names:
            names.append(match.group(1))
    return names


def read_bots(values: dict[str, str]) -> dict[str, dict[str, str]]:
    return {key: {"url": values.get(f"{key}_WEBHOOK_URL", ""), "auth": values.get(f"{key}_WEBHOOK_AUTH", "")}
            for key in bot_names(values)}


def known_keys(names: list[str]) -> set[str]:
    return {f"{key}_WEBHOOK_{part}" for key in names for part in ("URL", "AUTH")}


def render(bots: dict[str, dict[str, str]], extras: dict[str, str]) -> str:
    lines = [
        "# Grok Bot webhooks. Managed by bin/setup-bot-webhooks; mode 0600.",
        "# Do not commit this file.",
        "",
    ]
    for key, entry in bots.items():
        if entry.get("url"):
            lines.append(f"export {key}_WEBHOOK_URL={shell_quote(entry['url'])}")
        if entry.get("auth"):
            lines.append(f"export {key}_WEBHOOK_AUTH={shell_quote(entry['auth'])}")
    # Any other key in the file is kept as is: deleting a secret has no undo.
    for key in sorted(extras):
        if re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", key):
            lines.append(f"export {key}={shell_quote(extras[key])}")
    return "\n".join(lines) + "\n"


def write_env(path: Path, bots: dict[str, dict[str, str]], extras: dict[str, str]) -> bool:
    text = render(bots, extras)
    if path.is_symlink():
        raise OSError(f"refusing to write through a symlink: {path}")
    if path.exists():
        try:
            current = path.read_text()
        except OSError:
            current = None
        if current == text:
            os.chmod(path, 0o600)
            return False

    path.parent.mkdir(parents=True, exist_ok=True)
    # Only narrow the dedicated directory. A custom --env in $HOME must not chmod $HOME.
    if path.parent.name == "bot-webhooks":
        os.chmod(path.parent, 0o700)
    descriptor, temporary = tempfile.mkstemp(dir=path.parent, prefix=".env-")
    try:
        with os.fdopen(descriptor, "w") as handle:
            handle.write(text)
            handle.flush()
            os.fsync(handle.fileno())
        os.chmod(temporary, 0o600)
        os.replace(temporary, path)
        os.chmod(path, 0o600)
    finally:
        if os.path.exists(temporary):
            os.unlink(temporary)
    return True


def ask(label: str, hidden: bool, keep: bool) -> str:
    suffix = " [keep]" if keep else " [skip]"
    sys.stdout.write(f"  {label}{suffix}: ")
    sys.stdout.flush()
    if hidden and sys.stdin.isatty():
        try:
            value = getpass.getpass("")
        except EOFError:
            raise EndOfInput from None
    else:
        line = sys.stdin.readline()
        if not line:
            raise EndOfInput
        value = line
    return value.strip()


def interactive(bots: dict[str, dict[str, str]], names: list[str]) -> bool:
    changed = False
    prompted = False
    if not names:
        print("no bots configured; name one with --add NAME (repeatable)")
        return False
    for key in names:
        existing = bots.get(key, {})
        complete = bool(existing.get("url") and existing.get("auth"))
        print(f"{key}: {'configured' if complete else 'not configured'}")
        try:
            url = ask("webhook URL", hidden=False, keep=bool(existing.get("url")))
            prompted = True
            if not url:
                if not existing.get("url"):
                    print("  skipped (no URL)")
                    continue
                url = existing["url"]
            else:
                problem = url_error(url)
                if problem:
                    print(f"  skipped: {problem}")
                    continue

            auth = ask("authorization", hidden=True, keep=bool(existing.get("auth")))
            prompted = True
        except EndOfInput:
            print()
            if not prompted:
                print("setup-bot-webhooks: no input; run in a terminal or use --non-interactive",
                      file=sys.stderr)
            break

        host_changed = (
            existing.get("url")
            and urlsplit(url).hostname != urlsplit(existing["url"]).hostname
        )
        if not auth:
            if not existing.get("auth"):
                print("  skipped (no authorization value)")
                continue
            if host_changed:
                print("  skipped: the URL host changed, so enter the authorization value again")
                continue
            auth = existing["auth"]
        try:
            auth = notify.normalize_auth(auth)
        except ValueError as exc:
            print(f"  skipped: {exc}")
            continue

        entry = {"url": url, "auth": auth}
        if bots.get(key) != entry:
            bots[key] = entry
            changed = True
    return changed


def non_interactive(bots: dict[str, dict[str, str]], names: list[str]) -> bool:
    """Read <NAME>_WEBHOOK_* from the environment for the bots already in the file
    and those named with --add, never for any other name: an unrelated
    SLACK_WEBHOOK_URL must not be swept into the secrets file."""
    changed = False
    for key in names:
        url = os.environ.get(f"{key}_WEBHOOK_URL", "").strip()
        auth = os.environ.get(f"{key}_WEBHOOK_AUTH", "").strip()
        if not url and not auth:
            continue
        if not url or not auth:
            print(f"{key}: skipped (set both {key}_WEBHOOK_URL and {key}_WEBHOOK_AUTH)",
                  file=sys.stderr)
            continue
        problem = url_error(url)
        if problem:
            print(f"{key}: skipped: {problem}", file=sys.stderr)
            continue
        try:
            auth = notify.normalize_auth(auth)
        except ValueError as exc:
            print(f"{key}: skipped: {exc}", file=sys.stderr)
            continue
        entry = {"url": url, "auth": auth}
        if bots.get(key) != entry:
            bots[key] = entry
            changed = True
    return changed


def report(bots: dict[str, dict[str, str]], path: Path) -> None:
    print(f"file  {path}")
    if not bots:
        print("no bots configured; add one with --add NAME")
    for key in bots:
        entry = bots.get(key, {})
        complete = bool(entry.get("url") and entry.get("auth"))
        print(f"{key}  {'configured' if complete else 'not configured'}")


def rc_targets(home: Path, shell: str) -> list[Path]:
    name = Path(shell).name if shell else ""
    if not name:
        if (home / ".zshrc").exists():
            name = "zsh"
        elif (home / ".bashrc").exists():
            name = "bash"
    if "zsh" in name:
        primary, extra = ".zshrc", ".zprofile"
    elif "bash" in name:
        primary = ".bashrc"
        extra = ".bash_profile" if (home / ".bash_profile").exists() else ".profile"
    else:
        primary, extra = ".profile", None
    targets = [home / primary]
    if extra and (home / extra).exists():
        targets.append(home / extra)
    return targets


def rc_block(env_path: Path) -> str:
    default = notify.real_home() / ".config" / "bot-webhooks" / "env"
    if env_path == default and Path.home() == notify.real_home():
        source = '[ -f "$HOME/.config/bot-webhooks/env" ] && . "$HOME/.config/bot-webhooks/env"'
    else:
        quoted = shell_quote(str(env_path))
        source = f"[ -f {quoted} ] && . {quoted}"
    return "\n".join([
        BEGIN,
        'case ":$PATH:" in *":$HOME/.local/bin:"*) ;; *) PATH="$HOME/.local/bin:$PATH" ;; esac',
        "export PATH",
        source,
        END,
    ])


def update_rc(path: Path, block: str) -> bool:
    text = path.read_text() if path.exists() else ""
    if BEGIN in text and END in text:
        pattern = re.compile(re.escape(BEGIN) + r".*?" + re.escape(END), re.S)
        updated = pattern.sub(lambda _match: block, text)
    else:
        updated = text
        if updated and not updated.endswith("\n"):
            updated += "\n"
        if updated:
            updated += "\n"
        updated += block + "\n"
    if updated == text:
        return False
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(updated)
    return True


def main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(description="Configure Grok Bot webhook callbacks.")
    parser.add_argument("--check", action="store_true", help="show configured bots, no prompts")
    parser.add_argument("--non-interactive", action="store_true",
                        help="read <BOT>_WEBHOOK_URL and <BOT>_WEBHOOK_AUTH from the environment, "
                             "for bots already in the file and those named with --add")
    parser.add_argument("--add", action="append", default=[], metavar="NAME",
                        help="add a bot by name (A-Z, 0-9, _; repeatable)")
    parser.add_argument("--env", help="webhook env file for tests (notify-bot reads only the default path)")
    parser.add_argument("--rc", action="append", help="shell rc file to update (repeatable)")
    parser.add_argument("--no-rc", action="store_true", help="do not touch a shell rc file")
    args = parser.parse_args(argv)
    if args.no_rc and args.rc:
        parser.error("--rc and --no-rc cannot be used together")

    env_path = Path(args.env).expanduser() if args.env else (
        Path(os.environ["BOT_WEBHOOKS_ENV"]).expanduser()
        if os.environ.get("BOT_WEBHOOKS_ENV")
        else notify.default_env_path()
    )
    if env_path != notify.default_env_path():
        print(f"setup-bot-webhooks: note: notify-bot reads only {notify.default_env_path()}; "
              "a custom --env is for tests", file=sys.stderr)
    try:
        values = notify.load_config(env_path)
    except notify.ConfigError as exc:
        print(f"setup-bot-webhooks: {exc}", file=sys.stderr)
        return 1

    added = [name.strip().upper().replace("-", "_") for name in args.add]
    for name in added:
        if not notify.BOT_NAME.fullmatch(name):
            print(f"setup-bot-webhooks: --add {name!r}: a bot name is A-Z, 0-9 and _, starting with a letter",
                  file=sys.stderr)
            return 2
    bots = read_bots(values)
    names = list(bots) + [name for name in added if name not in bots]
    extras = {key: value for key, value in values.items() if key not in known_keys(list(bots))}

    if args.check:
        report(bots, env_path)
        return 0

    try:
        if args.non_interactive:
            changed = non_interactive(bots, names)
        else:
            changed = interactive(bots, names)
    except KeyboardInterrupt:
        print("\nsetup-bot-webhooks: interrupted; nothing written", file=sys.stderr)
        return 130

    if changed or (bots and not env_path.exists()):
        try:
            write_env(env_path, bots, extras)
        except OSError as exc:
            print(f"setup-bot-webhooks: cannot write {env_path}: {type(exc).__name__}",
                  file=sys.stderr)
            return 1
        print(f"wrote {env_path} (0600)")
    else:
        print(f"unchanged {env_path}")

    if not args.no_rc:
        targets = [Path(path).expanduser() for path in args.rc] if args.rc else \
            rc_targets(Path.home(), os.environ.get("SHELL", ""))
        for target in targets:
            if update_rc(target, rc_block(env_path)):
                print(f"updated {target}")

    print("run: notify-bot --list")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
