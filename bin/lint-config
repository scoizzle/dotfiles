#!/usr/bin/env python3
"""Check the permission policy of this opencode config, without running opencode.

    lint-config [repo]            # default: the repo this script lives in

It loads opencode.json and every agents/*.md, then evaluates concrete commands
and paths against each agent's effective rules and fails when the policy in
AGENTS.md and memory/core/safety.md is not what the rules actually produce.

Assumption, stated because opencode does not document it in its schema: rules are
ordered, the LAST matching rule wins, an agent's rules come after the global
ones, `*` matches any characters including spaces and slashes, and no match
means allow. The verifier's own rule order relies on the same reading. If
opencode changes that, these checks are the first thing that should break.

A text-matched denylist is not a security boundary (see docs/security-model.md).
This catches regressions in the denylist; it does not prove the denylist is enough.
"""
from __future__ import annotations

import fnmatch
import importlib.machinery
import importlib.util
import json
import os
import re
import subprocess
import sys
import tempfile
from pathlib import Path

ROOT = Path(sys.argv[1]).resolve() if len(sys.argv) > 1 else Path(__file__).resolve().parent.parent
EFFECTS = {"allow", "deny", "ask"}
READ_ONLY = ("review-deep", "advisor", "explore", "dream-drafter")
MACHINE_PATH = re.compile(r"/Users/[A-Za-z0-9._-]+|/home/[A-Za-z0-9._-]+|/private/var/folders|[A-Z]:\\Users\\")

failures: list[str] = []


def fail(message: str) -> None:
    failures.append(message)


def rule(action: str, resource: str, effect: str) -> tuple[str, str, str]:
    return (action, resource, effect)


def frontmatter(text: str) -> tuple[dict[str, str], list[tuple[str, str, str]]]:
    parts = text.split("---\n", 2)
    if len(parts) < 3 or parts[0] != "":
        return {}, []
    scalars: dict[str, str] = {}
    rules: list[tuple[str, str, str]] = []
    current: dict[str, str] = {}
    in_permissions = False

    def flush() -> None:
        nonlocal current
        if current:
            rules.append(rule(current.get("action", ""), current.get("resource", ""), current.get("effect", "")))
        current = {}

    for raw in parts[1].splitlines():
        if re.match(r"^permissions:\s*$", raw):
            in_permissions = True
            continue
        if in_permissions and raw.startswith(" "):
            inline = re.match(r'^\s*-\s*\{\s*action:\s*(\S+?),\s*resource:\s*"([^"]*)",\s*effect:\s*(\w+)\s*\}\s*$', raw)
            if inline:
                flush()
                rules.append(rule(*inline.groups()))
                continue
            item = re.match(r'^\s*(?:-\s+)?(action|resource|effect):\s*"?([^"]*?)"?\s*$', raw)
            if item:
                if raw.lstrip().startswith("- "):
                    flush()
                current[item.group(1)] = item.group(2)
            continue
        in_permissions = False
        flush()
        scalar = re.match(r"^([A-Za-z_]+):\s*(.*)$", raw)
        if scalar:
            scalars[scalar.group(1)] = scalar.group(2).strip().strip('"')
    flush()
    return scalars, rules


def effective(rules: list[tuple[str, str, str]], action: str, text: str) -> str:
    verdict = "allow"
    for r_action, resource, effect in rules:
        if r_action == action and fnmatch.fnmatchcase(text, resource):
            verdict = effect
    return verdict


def load_script(name: str):
    loader = importlib.machinery.SourceFileLoader(name.replace("-", "_"), str(ROOT / "bin" / name))
    module = importlib.util.module_from_spec(importlib.util.spec_from_loader(loader.name, loader))
    loader.exec_module(module)
    return module


def guard_event(vector: dict, claude_shape: bool) -> dict:
    tool = {"shell": ("Bash", "run_terminal_command"), "read": ("Read", "read_file"), "edit": ("Edit", "search_replace")}[vector["kind"]]
    key = "command" if vector["kind"] == "shell" else ("file_path" if claude_shape else "path")
    if claude_shape:
        return {"tool_name": tool[0], "tool_input": {key: vector["input"]}}
    return {"toolName": tool[1], "toolInput": {key: vector["input"]}}


def check_policy(agents: dict) -> None:
    """One policy, two engines (harness-guard and opencode): the same expected decisions hold in both."""
    os.environ["HARNESS_POLICY"] = str(ROOT / "policy" / "permissions.json")
    guard, sync = load_script("harness-guard"), load_script("sync-harness")
    policy = json.loads((ROOT / "policy" / "permissions.json").read_text())
    vectors = json.loads((ROOT / "policy" / "vectors.json").read_text())["vectors"]
    action = {"shell": "shell", "read": "read", "edit": "edit"}

    for number, v in enumerate(vectors):
        label = f"{v['kind']} `{v['input']!r}`"
        engines = v.get("engines", ["guard", "opencode"])
        if "guard" in engines:
            found = guard.decide(guard_event(v, claude_shape=number % 2 == 0))
            got = "deny" if any(d.kind == "deny" for d in found) else "ask" if found else "allow"
            if got != v["expect"]:
                fail(f"harness-guard: {label} is {got}, expected {v['expect']}")
        if "opencode" in engines:
            for name in v.get("agents", ["(global)", "verifier", "implementor"]):
                if name in v.get("skip_agents", []):
                    continue
                got = effective(agents[name], action[v["kind"]], v["input"])
                if got != v["expect"]:
                    fail(f"opencode/{name}: {label} is {got}, expected {v['expect']}")

    # the hook contract, end to end, in both payload shapes
    for payload, rc, decision in (
        ({"tool_name": "Bash", "tool_input": {"command": "git push --force"}}, 2, "deny"),
        ({"toolName": "run_terminal_command", "toolInput": {"command": "rm -rf x"}}, 2, "deny"),
        ({"tool_name": "Bash", "tool_input": {"command": "git push origin main"}}, 0, "ask"),
        ({"toolName": "run_terminal_command", "toolInput": {"command": "git status"}}, 0, None),
        ({"tool_name": "Read", "tool_input": {"file_path": "~/.ssh/id_rsa"}}, 2, "deny"),
        ({"toolName": "read_file", "toolInput": {"command": "x"}, "toolInputTruncated": True}, 2, "deny"),
        ({"tool_name": "Edit", "tool_input": {"file_path": "notes.md", "old_string": "x", "new_string": "x"}}, 2, "deny"),
        ({"toolName": "search_replace", "toolInput": {"path": "notes.md", "old_str": "x", "new_str": "x"}}, 2, "deny"),
        ({"tool_name": "Edit", "tool_input": {"file_path": "notes.md", "old_string": "x", "new_string": "y"}}, 0, None),
    ):
        run = subprocess.run([sys.executable, str(ROOT / "bin" / "harness-guard")], input=json.dumps(payload), capture_output=True, text=True, env=dict(os.environ))
        said = json.loads(run.stdout)["hookSpecificOutput"]["permissionDecision"] if run.stdout.strip() else None
        if (run.returncode, said) != (rc, decision) or (rc == 2 and not run.stderr.strip()):
            fail(f"harness-guard contract: {json.dumps(payload)[:70]} gave rc={run.returncode} decision={said}")
    bad = subprocess.run([sys.executable, str(ROOT / "bin" / "harness-guard")], input="not json", capture_output=True, text=True)
    if bad.returncode != 2:
        fail("harness-guard must fail closed (exit 2) on input it cannot parse")

    # rendered configs match the policy
    for path, want in sync.repo_targets(policy, ROOT).items():
        if path.read_text() != want:
            fail(f"{path.relative_to(ROOT)} drifted from policy/permissions.json; run bin/sync-harness --apply")


CONTRACT_CAP = 8000
MOVED_SKILLS = ("t3-dispatch", "consult-advisor", "finish-change", "memory", "roslynk-rules")
DESCRIPTION_TRIGGERS = {
    "finish-change": ("bot", "thread id"),
    "consult-advisor": ("design choice", "failed twice", "retarget a test"),
    "roslynk-rules": ("run-tests", "platform-detection", "test-anti-patterns", "assertion-quality"),
}
# Files that carry contract text: AGENTS.md, the lead's agent file, and the
# skills sections moved into. The escape-hatch and retired-word guards scan all.
CONTRACT_FILES = ("AGENTS.md", "docs/rules.md", "agents/build.md",
                  *(f"skills/{s}/SKILL.md" for s in MOVED_SKILLS))
POLICY_RULE_KEYS = ("no_edit", "protected", "control_plane")
ENFORCER_KINDS = ("policy", "test", "lint")


def resolve_enforcer(token: str, policy: dict, ci: str, lint_src: str) -> str | None:
    """None when the enforcer exists, else why it does not."""
    kind, _, name = token.partition(":")
    if kind == "policy":
        ids = set()
        def walk(node):
            if isinstance(node, dict):
                if "id" in node:
                    ids.add(node["id"])
                for value in node.values():
                    walk(value)
            elif isinstance(node, list):
                for value in node:
                    walk(value)
        walk(policy)
        # Rule ids, plus the policy sections that are rules themselves. A key such
        # as `version` or `doc` is not (review of dba84ac).
        return None if name in ids or name in POLICY_RULE_KEYS else f"no policy rule or key {name!r}"
    if kind == "test":
        if not (ROOT / "tests" / name).is_file():
            return f"no tests/{name}"
        runs = re.search(rf"^[ \t]*(?:-[ \t]+)?(?:run:[ \t]*)?python3 tests/{re.escape(name)}[ \t]*$", ci, flags=re.M)
        return None if runs else f"tests/{name} does not run in CI"
    if kind == "lint":
        defined = re.search(rf"^def {re.escape(name)}\(", lint_src, flags=re.M)
        main = re.search(r"^def main\(.*?(?=^def |\Z)", lint_src, flags=re.M | re.S)
        called = main and re.search(rf"^    {re.escape(name)}\(\)", main.group(0), flags=re.M)
        return None if defined and called else f"no lint check {name} called from main"
    return f"unknown enforcer kind {kind!r} (use {', '.join(ENFORCER_KINDS)} or judgment)"


def check_contract() -> None:
    """AGENTS.md stays small and every rule in its table names an enforcer that exists.

    v2 replaced ~100 exact-phrase needles, which froze wording and proved
    nothing about behaviour, with this: a size cap, and a table pairing each
    rule with the policy rule, test or lint check that makes it true. A
    `judgment` rule must name the failure it prevents. The escape-hatch and
    retired-word checks stay: they catch text that made the review skippable
    (#44) or restored the tier cascade, without pinning any wording.
    """
    agents_text = (ROOT / "AGENTS.md").read_text()
    if len(agents_text) > CONTRACT_CAP:
        fail(f"AGENTS.md is {len(agents_text)} characters, over the {CONTRACT_CAP} cap; raising the cap is its own change")
    # The rule table lives in docs/rules.md (the person, 2026-11-23): every
    # session loads AGENTS.md, and the model does not need the table.
    if "docs/rules.md" not in agents_text:
        fail("AGENTS.md no longer points at docs/rules.md; the enforced rules have no index")
    rules_path = ROOT / "docs" / "rules.md"
    text = rules_path.read_text() if rules_path.exists() else ""
    heading = "## Rules and what enforces them"
    if heading not in text:
        fail(f"docs/rules.md: missing {heading!r}; rules have no enforcers")
    else:
        policy = json.loads((ROOT / "policy" / "permissions.json").read_text())
        ci = (ROOT / ".github" / "workflows" / "ci.yml").read_text()
        lint_src = Path(__file__).read_text()
        table = [line for line in text.split(heading, 1)[1].splitlines() if line.startswith("|")]
        if not table or [c.strip() for c in table[0].strip().strip("|").split("|")] != ["Rule", "Enforcer", "Failure it prevents"]:
            fail("docs/rules.md rule table: the header row must be | Rule | Enforcer | Failure it prevents |")
        rows = [line for line in table[1:] if not re.fullmatch(r"\|[\s|:-]+", line)]
        if not rows:
            fail("docs/rules.md: the rule table has no rows")
        for line in rows:
            cells = [c.strip() for c in line.strip().strip("|").split("|")]
            if len(cells) != 3:
                fail(f"docs/rules.md rule table: {line[:80]!r} needs rule | enforcer | failure")
                continue
            rule_text, enforcers, failure = cells
            for token in (t.strip() for t in enforcers.split(",")):
                if token == "judgment":
                    if failure in ("", "—", "-"):
                        fail(f"docs/rules.md rule table: judgment rule {rule_text[:60]!r} names no failure it prevents")
                    continue
                why = resolve_enforcer(token, policy, ci, lint_src)
                if why:
                    fail(f"docs/rules.md rule table: {rule_text[:60]!r}: {why}")
    # Each section moved out of AGENTS.md leaves a pointer to a skill that exists
    # (the person, 2026-11-23), and the moved text keeps the same guards.
    for skill in MOVED_SKILLS:
        if f"`{skill}`" not in agents_text:
            fail(f"AGENTS.md no longer points at {skill}; its rules are unreachable")
        elif not (ROOT / "skills" / skill / "SKILL.md").exists():
            fail(f"AGENTS.md points at {skill}, but skills/{skill}/SKILL.md is missing")
    # A trigger that left AGENTS.md must be in its skill's description, which
    # every session loads; a body loads only on demand (review, 2026-11-23).
    for skill, words in DESCRIPTION_TRIGGERS.items():
        path = ROOT / "skills" / skill / "SKILL.md"
        found = re.search(r"^description:(.*)$", path.read_text(), re.M) if path.exists() else None
        description = found.group(1) if found else ""
        for word in words:
            if word not in description:
                fail(f"skills/{skill}: its description lost the trigger {word!r}; a session no longer sees when it applies")
    guarded = {name: (ROOT / name).read_text() for name in CONTRACT_FILES if (ROOT / name).exists()}
    for name, body in guarded.items():
        for stale in (
            "or say that no second model was available",
            "say so and continue",
            "Do not stop to ask about fallbacks",
        ):
            if stale in body:
                fail(f"{name}: the old escape hatch is back ({stale!r}); the sensitive review is skippable again")
        if "Do not stage, commit, or push unless asked" in body:
            fail(f"{name}: the old commit/push gate is back; a finished change must open and watch its PR")
    for stale in ("Tier: T0", "plan-review-deep", "review-light", "second-opinion"):
        for name in CONTRACT_FILES:
            if stale in (ROOT / name).read_text():
                fail(f"{name}: the retired tier cascade is back ({stale!r})")
    verify = (ROOT / "commands" / "verify.md").read_text()
    for needle in (
        "review-bundle . --show AGENTS.md --show docs/rules.md --show agents/review-deep.md",
        "base copies",
    ):
        if needle not in verify:
            fail(f"commands/verify.md: missing {needle!r}; the reviewer loses the base rules it judges by")
    for name, needles in (
        ("skills/roslynk-rules/SKILL.md", ("run-tests", "platform-detection", "test-anti-patterns", "assertion-quality")),
        ("agents/build.md", ("run-tests",)),
        ("agents/implementor.md", ("run-tests", "assertion-quality")),
        ("agents/verifier.md", ("run-tests",)),
        ("agents/review-deep.md", ("assertion-quality",)),
    ):
        body = (ROOT / name).read_text()
        for needle in needles:
            if needle not in body:
                fail(f"{name}: missing skill wiring {needle!r}")


def check_guard_allow() -> None:
    """policy guard_allow may only turn off an ask, never a deny (advisor, 2026-11-23)."""
    policy = json.loads((ROOT / "policy" / "permissions.json").read_text())
    guard_src = (ROOT / "bin" / "harness-guard").read_text()
    asks = {r["id"] for r in policy["shell"]["ask"]} | set(re.findall(r'Decision\("ask", "([\w-]+)"', guard_src))
    denies = {r["id"] for r in policy["shell"]["deny"]} | set(re.findall(r'Decision\("deny", "([\w-]+)"', guard_src))
    for rule_id in policy.get("guard_allow", []):
        if rule_id in denies or rule_id not in asks:
            fail(f"policy guard_allow: {rule_id!r} is not an ask rule; guard_allow may only turn off an ask, never a deny")


def check_plugins() -> None:
    """OpenCode 2 loads a plugin only as a default definition with an id and a
    setup or effect. It rejects the v1 named-export shape with one warn line in
    a log, so lint has to catch that shape instead.

    This is a text match of the file, not a parse and not a load: a comment can
    satisfy the shape, and a future API rename is invisible here. The load path
    itself was verified against opencode 2.3.0 by running a server with this
    file and reading the Claude child's environment. The id pattern is a local
    convention, not a documented host rule.
    """
    plugin_dir = ROOT / "plugins"
    files = sorted(plugin_dir.glob("*.js")) if plugin_dir.is_dir() else []
    if not files:
        fail("plugins/: no plugin files; the Claude entrypoint label is gone")
        return
    seen: dict[str, str] = {}
    for path in files:
        text = path.read_text()
        export = re.search(r"^export\s+default\s+", text, flags=re.M)
        if not export:
            fail(f"plugins/{path.name}: no `export default`; OpenCode 2 rejects a named export at load")
            continue
        definition = text[export.end():]
        ident = re.search(r"""\bid:\s*["']([^"']+)["']""", definition)
        if not ident:
            fail(f"plugins/{path.name}: the default definition has no quoted id")
            continue
        if not re.search(r"\b(setup|effect)\s*[(:]", definition):
            fail(f"plugins/{path.name}: the default definition has no setup or effect")
        name = ident.group(1)
        if not re.fullmatch(r"[a-z0-9][a-z0-9.-]*", name):
            fail(f"plugins/{path.name}: bad plugin id {name!r}")
        elif name in seen:
            fail(f"plugins/{path.name}: duplicate plugin id {name!r} (also in {seen[name]})")
        seen.setdefault(name, path.name)
    # v2 runs Claude through opencode again (the person's decision, 2026-11-22),
    # so its Claude Agent SDK traffic needs the entrypoint label once more.
    entry = plugin_dir / "claude-entrypoint.js"
    if not entry.exists():
        fail("plugins/claude-entrypoint.js is missing; the Claude entrypoint label is gone")
        return
    entry_text = entry.read_text()
    export = re.search(r"^export\s+default\s+", entry_text, flags=re.M)
    if export and not re.search(r"process\.env\.CLAUDE_CODE_ENTRYPOINT\s*=", entry_text[export.end():]):
        fail("plugins/claude-entrypoint.js: no longer assigns CLAUDE_CODE_ENTRYPOINT; Claude traffic is metered as sdk-*")



def main() -> int:
    config = json.loads((ROOT / "opencode.json").read_text())
    base = [rule(r["action"], r["resource"], r["effect"]) for r in config.get("permissions", [])]
    for r in config.get("permissions", []):
        if r["effect"] not in EFFECTS:
            fail(f"opencode.json: bad effect {r['effect']!r}")

    role_map = json.loads((ROOT / "models" / "roles.json").read_text())["agents"]
    agents: dict[str, list[tuple[str, str, str]]] = {}
    for name, body in config.get("agents", {}).items():
        agents[name] = base + [rule(r["action"], r["resource"], r["effect"]) for r in body.get("permissions", [])]
    for path in sorted((ROOT / "agents").glob("*.md")):
        scalars, rules = frontmatter(path.read_text())
        name = path.stem
        for key in ("description", "steps"):
            if not scalars.get(key):
                fail(f"agents/{path.name}: missing {key}")
        if "model" in scalars:
            fail(f"agents/{path.name}: model {scalars['model']!r} is pinned; an agent's model comes from its role "
                 "(models/roles.json), and opencode lets frontmatter win over the person's choice")
        if name not in role_map:
            fail(f"agents/{path.name}: {name} has no role in models/roles.json")
        for r in rules:
            if r[2] not in EFFECTS:
                fail(f"agents/{path.name}: bad effect {r[2]!r}")
        seen: set[tuple[str, str, str]] = set()
        for r in rules:
            if r in seen:
                fail(f"agents/{path.name}: duplicate rule {r}")
            seen.add(r)
        agents[name] = base + rules
    agents.setdefault("(global)", base)

    never_push = (
        "git push --force", "git push -f", "git push origin main --force", "git push origin main -f",
        "git push -u origin main -f", "git push origin +main", "git push origin --delete main",
        "git push --mirror", 'sh -c "git push --force"', "git -C . push --force",
    )
    never_run = ("git reset --hard", "git clean -fd", "rm -rf x", "rm -fr x", "rm -r -f x", "sudo ls")
    never_shell_read = ("cat ~/.ssh/id_rsa", "cat ~/.aws/credentials", "cat ~/.claude/.credentials.json",
                        "cat ~/.local/share/opencode/auth.json", "cat ~/.config/gh/hosts.yml",
                        "cat ~/.config/bot-webhooks/env")
    never_read = ("~/.ssh/id_rsa", "~/.aws/credentials", "~/.claude/.credentials.json",
                  "~/.local/share/opencode/auth.json", "~/.config/bot-webhooks/env",
                  "/work/.env", ".env", ".env.local", "/work/service.json")

    for name, rules in sorted(agents.items()):
        for command in never_push:
            if effective(rules, "shell", command) != "deny":
                fail(f"{name}: `{command}` is {effective(rules, 'shell', command)}, must be deny")
        # Plain `git push` is off in the person's sessions (2026-11-23); a push to the
        # default branch still asks, and a role session still denies any push (plugin).
        if effective(rules, "shell", "git push origin main") == "allow":
            fail(f"{name}: `git push origin main` is allow; a push to the default branch must be ask or deny")
        for command in never_run + never_shell_read:
            if effective(rules, "shell", command) != "deny":
                fail(f"{name}: `{command}` is {effective(rules, 'shell', command)}, must be deny")
        for target in never_read:
            if effective(rules, "read", target) != "deny":
                fail(f"{name}: read {target} is {effective(rules, 'read', target)}, must be deny")
        if effective(rules, "read", "src/x.cs") != "deny" and effective(rules, "read", "/work/.env.example") == "deny":
            fail(f"{name}: .env.example should stay readable")
        for target in ("memory/core/safety.md", "~/.config/opencode/memory/core/safety.md"):
            if effective(rules, "edit", target) != "deny":
                fail(f"{name}: edit {target} is {effective(rules, 'edit', target)}, must be deny")

    for name in READ_ONLY:
        rules = agents.get(name)
        if rules is None:
            fail(f"read-only agent {name} has no agents/{name}.md")
            continue
        for action, sample in (("edit", "src/x.cs"), ("shell", "ls"), ("subagent", "explore"),
                               ("execute", "*"), ("webfetch", "*"), ("websearch", "*"),
                               ("question", "*"), ("opencode_session_rename", "*"),
                               ("opencode_worktree_create", "*"), ("opencode_worktree_remove", "*"),
                               ("opencode_session_move", "*"), ("roslynk_apply_patch", "*"),
                               ("roslynk_apply_code_fix", "*"), ("roslynk_apply_code_action", "*"),
                               ("roslynk_change_signature", "*"), ("roslynk_extract_method", "*"),
                               ("roslynk_rename_symbol", "*"), ("roslynk_rename_parameter", "*"),
                               ("roslynk_remove_unused_usings", "*")):
            if effective(rules, action, sample) != "deny":
                fail(f"{name}: {action} must be deny")
    if "dream-drafter" in agents and effective(agents["dream-drafter"], "read", "src/x.cs") != "deny":
        fail("dream-drafter: read must be deny; it handles untrusted text")

    explore = agents.get("explore")
    if explore is not None and effective(explore, "browser", "*") != "deny":
        fail("explore: browser must be deny; it is the read-only swarm")

    build = agents.get("build")
    if build is None:
        fail("build: agents/build.md is missing; it is the default agent")
    else:
        build_text = (ROOT / "agents" / "build.md").read_text()
        if config.get("default_agent") != "build":
            fail("build: default_agent must be build")
        if effective(build, "read", "src/x.cs") != "allow":
            fail("build: read must stay allowed")
        if effective(build, "edit", "src/x.cs") != "allow":
            fail("build: edit must be allow; the default agent does the work")
        if effective(build, "shell", "ls") != "allow":
            fail("build: shell must be allow; the default agent does the work")
        if effective(build, "external_directory", "/tmp/x") != "allow":
            fail("build: external_directory must be allow; the person turned off its prompt (2026-11-23)")
        if effective(build, "subagent", "explore") != "deny":
            fail("build: subagent must be deny; all dispatch goes through T3 delegate_task")
        if "EXECUTE ALLOWLIST:" in build_text:
            fail("build: EXECUTE ALLOWLIST is the retired dispatcher fence")
        project_build = ROOT / ".opencode" / "agents" / "build.md"
        if not project_build.exists() or project_build.resolve() != (ROOT / "agents" / "build.md").resolve():
            fail(".opencode/agents/build.md must resolve to agents/build.md")

    implementor = agents.get("implementor")
    if implementor is None:
        fail("implementor: agents/implementor.md is missing; it is the direct-work agent")
    else:
        for action in ("read", "edit", "shell"):
            if effective(implementor, action, "src/x.cs") != "allow":
                fail(f"implementor: {action} must stay allowed; it does the work")
        if effective(implementor, "subagent", "*") != "deny":
            fail("implementor: subagent must be deny; it is a unit, not a dispatcher")
        if effective(implementor, "execute", "*") != "deny":
            fail("implementor: execute must be deny; only the orchestrator has the T3 channel")

    check_policy(agents)
    check_guard_allow()
    check_contract()
    check_plugins()

    for rel in ("AGENTS.md", "opencode.json", "agents", "commands", "skills", "bin/dream", "bin/review-bundle", "memory/core", "memory/INDEX.md"):
        target = ROOT / rel
        files = [target] if target.is_file() else sorted(p for p in target.rglob("*") if p.is_file())
        for file in files:
            for number, line in enumerate(file.read_text(errors="replace").splitlines(), 1):
                if MACHINE_PATH.search(line):
                    fail(f"{file.relative_to(ROOT)}:{number}: machine-specific path")

    dream = (ROOT / "bin" / "dream").read_text()
    argv = re.search(r"OPENCODE_ARGV = \(([^)]*)\)", dream)
    if not argv or '"--auto"' in argv.group(1) or '"dream-drafter"' not in argv.group(1):
        fail("bin/dream: must draft with --agent dream-drafter and without --auto")

    if failures:
        print("lint-config: FAIL")
        for message in failures:
            print(f"  - {message}")
        return 1
    print(f"lint-config: ok ({len(agents)} agents checked)")
    return 0


if __name__ == "__main__":
    sys.exit(main())
