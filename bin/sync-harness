#!/usr/bin/env python3
"""Render policy/permissions.json into the native config of every harness.

    sync-harness                      # --check: show drift, change nothing (exit 1 if any)
    sync-harness --apply              # write it
    sync-harness --scope repo|home|all
    sync-harness --scope managed      # print the root-owned rules to install; writes nothing
    sync-harness --home DIR           # act on DIR instead of $HOME (tests)

Targets:

  repo   opencode.json `permissions`, and the managed block in agents/verifier.md
         (its `shell *: allow` would otherwise erase the global shell rules).
  home   ~/.claude/settings.json: `permissions.deny/ask` rules and a PreToolUse
         hook running bin/harness-guard. Claude Code reads both. Grok Build reads
         the rules everywhere and the hook in folders it trusts
         (~/.grok/trusted_folders.toml; verified with `grok inspect`). The same
         step adds the read-only reviewers under ~/.claude/agents and registers the
         Roslynk MCP server for Claude Code. ~/.grok/config.toml is never touched.
  managed  opt-in, never part of `all`, writes nothing: prints the rules for the
         root-owned /Library/Application Support/ClaudeCode/managed-settings.json,
         which both harnesses read in every folder, and the sudo command a person
         runs. It carries rules only.

The home merge is additive and idempotent: it adds missing rules, replaces its own
hook entry (found by the `harness-guard` command name), and keeps everything else.
It backs the file up before writing. Retired rules are not removed automatically.
"""
from __future__ import annotations

import argparse
import datetime
import difflib
import json
import os
import re
import shutil
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
HOOK_MATCHER = (
    "Bash|Read|Grep|Glob|LS|Edit|Write|MultiEdit|NotebookEdit|"
    "run_terminal_command|read_file|grep|list_dir|search_replace|hashline_edit|write"
)
BEGIN = "  # BEGIN managed by bin/sync-harness (from policy/permissions.json); edit the policy, not this block."
END = "  # END managed by bin/sync-harness"


def rule(action: str, resource: str, effect: str) -> dict:
    return {"action": action, "resource": resource, "effect": effect}


def render_opencode(policy: dict) -> list[dict]:
    out = [rule("skill", s, "deny") for s in policy["opencode"]["skill_deny"]]
    out += shell_rules(policy)
    prot = policy["protected"]
    for entry in prot["paths"]:
        rel = entry[2:]
        if entry.endswith("/"):
            out += [rule("shell", f"*/{rel}*", "deny"), rule("shell", f"*~/{rel.rstrip('/')}*", "deny")]
            out.append(rule("read", entry + "*", "deny"))
        else:
            out += [rule("shell", f"*/{rel}" + ("" if rel.endswith("*") else "*"), "deny"), rule("read", entry, "deny")]
    out += [rule("shell", g, "deny") for g in policy["opencode"].get("shell_deny_extra", [])]
    for name in prot["names"]:
        out += [rule("shell", f"*{name}*", "deny"), rule("read", f"**/{name}", "deny")]
    for glob in prot["name_globs"]:
        out += [rule("read", f"**/{glob}", "deny"), rule("read", glob, "deny")]
    out += [rule("read", g, "deny") for g in policy["opencode"]["read_deny_extra"]]
    for allowed in prot["name_allow"]:
        out += [rule("read", f"**/{allowed}", "allow"), rule("read", allowed, "allow")]
    for d in policy["no_edit"]:
        out += [rule("edit", f"{d}/*", "deny"), rule("edit", f"*/{d}/*", "deny")]
    return dedupe(out)


def shell_rules(policy: dict) -> list[dict]:
    out: list[dict] = []
    for kind in ("ask", "deny"):
        for r in policy["shell"][kind]:
            out += [rule("shell", g, kind) for g in r["opencode"]]
    return out


def dedupe(rules: list[dict]) -> list[dict]:
    seen, out = set(), []
    for r in rules:
        key = (r["action"], r["resource"], r["effect"])
        if key not in seen:
            seen.add(key)
            out.append(r)
    return out


def render_native(policy: dict) -> dict:
    ask = [n for r in policy["shell"]["ask"] for n in r["native"]]
    deny = [n for r in policy["shell"]["deny"] for n in r["native"]]
    prot = policy["protected"]
    for entry in prot["paths"]:
        deny.append(f"Read({entry}**)" if entry.endswith("/") else f"Read({entry})")
    deny += [f"Read(**/{n})" for n in prot["names"]]
    deny += [f"Read(**/{n})" for n in prot["native_env_files"]]
    for d in policy["no_edit"]:
        deny += [f"Edit(**/{d}/**)", f"Write(**/{d}/**)"]
    return {"deny": list(dict.fromkeys(deny)), "ask": list(dict.fromkeys(ask))}


def dump_opencode(config: dict) -> str:
    text = json.dumps(config, indent=2, ensure_ascii=False)
    text = re.sub(
        r'\{\s*"action": ("[^"]*"),\s*"resource": ("[^"]*"),\s*"effect": ("[^"]*")\s*\}',
        r'{ "action": \1, "resource": \2, "effect": \3 }',
        text,
    )
    return text + "\n"


def verifier_block(policy: dict) -> str:
    lines = [BEGIN, "  # `shell *: allow` above would erase the global shell rules (last match wins), so they are restated here."]
    shell = [r for r in render_opencode(policy) if r["action"] == "shell"]
    lines += [f'  - {{ action: shell, resource: "{r["resource"]}", effect: {r["effect"]} }}' for r in shell]
    lines.append(END)
    return "\n".join(lines)


def repo_targets(policy: dict, repo: Path) -> dict[Path, str]:
    config_path = repo / "opencode.json"
    config = json.loads(config_path.read_text())
    config["permissions"] = render_opencode(policy)
    targets = {config_path: dump_opencode(config)}

    agent = repo / "agents" / "verifier.md"
    text = agent.read_text()
    block = verifier_block(policy)
    if BEGIN in text:
        text = re.sub(re.escape(BEGIN) + r".*?" + re.escape(END), lambda _m: block, text, flags=re.S)
    else:
        marker = '  - { action: shell, resource: "sudo *", effect: deny }'
        old = re.search(r"  # `shell \*: allow` above.*?(?=\n---\n)", text, flags=re.S)
        if old:
            text = text[: old.start()] + block + text[old.end():]
        elif marker in text:
            text = text.replace(marker, marker + "\n" + block, 1)
        else:
            raise SystemExit("agents/verifier.md: no place to put the managed block")
    targets[agent] = text
    return targets


def home_target(policy: dict, home: Path) -> tuple[Path, str, list[str]]:
    path = home / ".claude" / "settings.json"
    settings = json.loads(path.read_text()) if path.exists() else {}
    native = render_native(policy)
    notes: list[str] = []
    perms = settings.setdefault("permissions", {})
    for kind in ("deny", "ask"):
        have = perms.setdefault(kind, [])
        added = [r for r in native[kind] if r not in have]
        have.extend(added)
        if added:
            notes.append(f"permissions.{kind}: +{len(added)} rule(s)")
    guard = str(home / ".config" / "opencode" / "bin" / "harness-guard")
    entry = {"matcher": HOOK_MATCHER, "hooks": [{"type": "command", "command": guard, "timeout": 10}]}
    hooks = settings.setdefault("hooks", {}).setdefault("PreToolUse", [])
    index = next((i for i, h in enumerate(hooks) if any(str(x.get("command", "")).endswith("harness-guard") for x in h.get("hooks", []))), None)
    if index is None:
        hooks.append(entry)
        notes.append("hooks.PreToolUse: +harness-guard")
    elif hooks[index] != entry:
        hooks[index] = entry
        notes.append("hooks.PreToolUse: harness-guard entry updated")
    return path, json.dumps(settings, indent=2, ensure_ascii=False) + "\n", notes


def agent_body(path: Path) -> tuple[str, str]:
    """(description, body) of an opencode-format agent file."""
    parts = path.read_text().split("---\n", 2)
    description = re.search(r"^description:\s*(.+)$", parts[1], flags=re.M).group(1).strip().strip('"')
    return description, parts[2].lstrip("\n")


def render_claude_agents(policy: dict, repo: Path) -> dict[str, str]:
    """name -> Claude Code subagent file. Read-only tools only, so a review cannot edit."""
    spec = policy["readonly_agents"]
    tools = spec["tools"] + [f"mcp__roslynk__{t}" for t in spec["roslynk_read_tools"]]
    out = {}
    for name, model in spec["models"].items():
        description, body = agent_body(repo / "agents" / f"{name}.md")
        out[name] = (
            "---\n"
            f"name: {name}\n"
            f"description: {json.dumps(description, ensure_ascii=False)}\n"
            f"tools: {', '.join(tools)}\n"
            f"model: {model}\n"
            "---\n"
            f"<!-- Generated by bin/sync-harness from agents/{name}.md. Edit that file and the policy, not this one. -->\n\n"
            f"{body}"
        )
    return out


def agents_changes(policy: dict, repo: Path, home: Path) -> list[tuple[Path, str]]:
    base = home / ".claude" / "agents"
    return [(base / f"{n}.md", t) for n, t in render_claude_agents(policy, repo).items() if not (base / f"{n}.md").exists() or (base / f"{n}.md").read_text() != t]


GENERATED = "Generated by bin/sync-harness"


def write_agent(path: Path, text: str) -> Path | None:
    """Write a rendered agent. A file that is not one of ours is backed up first, never overwritten."""
    backup = None
    if path.exists() and GENERATED not in path.read_text():
        stamp = datetime.datetime.now(datetime.timezone.utc).strftime("%Y%m%dT%H%M%SZ")
        backup = path.with_name(f"{path.name}.bak-{stamp}")
        shutil.copy2(path, backup)
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(text)
    return backup


def roslynk_registration(home: Path) -> tuple[str, list[str]]:
    """('ok'|'missing'|'skip: why', command to register). Claude Code has no Roslynk unless it is registered."""
    binary = home / ".dotnet" / "tools" / "roslynk"
    if shutil.which("claude") is None:
        return "skip: claude CLI not on PATH", []
    if not binary.exists():
        return f"skip: {binary} not installed (dotnet tool install -g roslynk)", []
    env = {**os.environ, "HOME": str(home)}
    have = subprocess.run(["claude", "mcp", "get", "roslynk"], capture_output=True, text=True, env=env)
    if have.returncode == 0:
        return "ok", []
    return "missing", ["claude", "mcp", "add", "--scope", "user", "roslynk", "--", str(binary), "stdio"]


MANAGED_SETTINGS = Path("/Library/Application Support/ClaudeCode/managed-settings.json")


def managed_settings(policy: dict) -> str:
    native = render_native(policy)
    return json.dumps({"permissions": {"deny": native["deny"], "ask": native["ask"]}}, indent=2, ensure_ascii=False) + "\n"


def print_managed(policy: dict) -> None:
    state = "present" if MANAGED_SETTINGS.exists() else "absent"
    print(f"{state:8}{MANAGED_SETTINGS}")
    print("".join("        " + line + "\n" for line in managed_settings(policy).splitlines()))
    print("install (a person runs these; this script never uses sudo):")
    print('  sudo mkdir -p "/Library/Application Support/ClaudeCode"')
    print('  sudo tee "/Library/Application Support/ClaudeCode/managed-settings.json"   # paste the JSON above')


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument("--apply", action="store_true", help="write the changes (default: only report drift)")
    parser.add_argument("--check", action="store_true", help="report drift (the default)")
    parser.add_argument("--scope", choices=("repo", "home", "all", "managed"), default="all")
    parser.add_argument("--home", default=str(Path.home()), help="home directory to act on (default $HOME)")
    parser.add_argument("--repo", default=str(ROOT), help="repo to act on (default this repo)")
    args = parser.parse_args()
    repo, home = Path(args.repo), Path(args.home)
    policy = json.loads((repo / "policy" / "permissions.json").read_text())

    if args.scope == "managed":
        print_managed(policy)
        return 0

    drift = False
    if args.scope in ("repo", "all"):
        for path, want in repo_targets(policy, repo).items():
            have = path.read_text()
            if have == want:
                print(f"ok      {path.relative_to(repo)}")
                continue
            drift = True
            print(f"drift   {path.relative_to(repo)}")
            sys.stdout.writelines(list(difflib.unified_diff(have.splitlines(True), want.splitlines(True), "current", "policy", n=0))[:60])
            if args.apply:
                path.write_text(want)
    if args.scope in ("home", "all"):
        for path, text in agents_changes(policy, repo, home):
            drift = True
            mine = path.exists() and GENERATED not in path.read_text()
            print(f"drift   {path}" + ("  (not generated by this script: backed up first)" if mine else ""))
            if args.apply:
                backup = write_agent(path, text)
                if backup:
                    print(f"        backup {backup}")
        state, command = roslynk_registration(home)
        if state == "missing":
            drift = True
            print("drift   Claude Code has no Roslynk MCP server: " + " ".join(command))
            if args.apply:
                result = subprocess.run(command, capture_output=True, text=True, env={**os.environ, "HOME": str(home)})
                print("        registered" if result.returncode == 0 else f"        FAILED: {result.stderr.strip()[:200]}")
        elif state != "ok":
            print(f"note    roslynk MCP for Claude Code: {state}")
        path, want, notes = home_target(policy, home)
        if not notes:
            print(f"ok      {path}")
        else:
            drift = True
            print(f"drift   {path}")
            for note in notes:
                print(f"        {note}")
            if args.apply:
                path.parent.mkdir(parents=True, exist_ok=True)
                if path.exists():
                    stamp = datetime.datetime.now(datetime.timezone.utc).strftime("%Y%m%dT%H%M%SZ")
                    backup = path.with_name(f"{path.name}.bak-{stamp}")
                    shutil.copy2(path, backup)
                    print(f"        backup {backup}")
                path.write_text(want)
    if drift and args.apply:
        print("applied")
        return 0
    return 1 if drift else 0


if __name__ == "__main__":
    sys.exit(main())
