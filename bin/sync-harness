#!/usr/bin/env python3
"""Render policy/permissions.json into opencode's config.

    sync-harness              # --check: show drift, change nothing (exit 1 if any)
    sync-harness --apply      # write it

It renders opencode.json `permissions` and each agent's `{file:}` model from
models/roles.json. The target is a tracked file in this repo, so a write shows
up in git and in review. opencode is the one harness, so nothing is rendered for
Claude Code.
"""
from __future__ import annotations

import argparse
import difflib
import json
import re
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent


def rule(action: str, resource: str, effect: str) -> dict:
    return {"action": action, "resource": resource, "effect": effect}


def render_opencode(policy: dict) -> list[dict]:
    out = [rule("skill", s, "deny") for s in policy["opencode"]["skill_deny"]]
    out += [rule(tool, "*", "deny") for tool in policy["opencode"].get("tool_deny", [])]
    out += [rule(tool, "*", "allow") for tool in policy["opencode"].get("tool_allow", [])]
    return dedupe(out)


def dedupe(rules: list[dict]) -> list[dict]:
    seen, out = set(), []
    for r in rules:
        key = (r["action"], r["resource"], r["effect"])
        if key not in seen:
            seen.add(key)
            out.append(r)
    return out


def dump_opencode(config: dict) -> str:
    text = json.dumps(config, indent=2, ensure_ascii=False)
    text = re.sub(
        r'\{\s*"action": ("[^"]*"),\s*"resource": ("[^"]*"),\s*"effect": ("[^"]*")\s*\}',
        r'{ "action": \1, "resource": \2, "effect": \3 }',
        text,
    )
    return text + "\n"


ROLE_FILE = "{file:~/.config/opencode/models/%s}"


def render_models(config: dict, repo: Path) -> None:
    """Point every agent's model at its role's file (bin/models writes them).

    The repo names roles, never model ids, so a friend's subscription decides
    the model, not this file (models/roles.json). opencode.json is also the
    project config inside this repo, where it outranks the person's global one.
    """
    roles = json.loads((repo / "models" / "roles.json").read_text())
    config["model"] = ROLE_FILE % roles["default_model_role"]
    agents = config.setdefault("agents", {})
    for name, role in sorted(roles["agents"].items()):
        agents.setdefault(name, {})["model"] = ROLE_FILE % role


def repo_targets(policy: dict, repo: Path) -> dict[Path, str]:
    config_path = repo / "opencode.json"
    config = json.loads(config_path.read_text())
    config["permissions"] = render_opencode(policy)
    render_models(config, repo)
    return {config_path: dump_opencode(config)}


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[1])
    parser.add_argument("--apply", action="store_true", help="write the changes (default: only report drift)")
    parser.add_argument("--check", action="store_true", help="report drift (the default)")
    parser.add_argument("--scope", choices=("repo",), default="repo",
                        help="kept for older callers; repo is the only scope")
    parser.add_argument("--repo", default=None, help="repo to act on (default: this repo)")
    args = parser.parse_args()
    repo = Path(args.repo) if args.repo else ROOT
    policy = json.loads((repo / "policy" / "permissions.json").read_text())

    drift = False
    for path, want in repo_targets(policy, repo).items():
        have = path.read_text()
        if have == want:
            print(f"ok      {path.relative_to(repo)}")
            continue
        drift = True
        print(f"drift   {path.relative_to(repo)}")
        sys.stdout.writelines(list(difflib.unified_diff(have.splitlines(True), want.splitlines(True), "current", "policy", n=0))[:60])
        if args.apply:
            path.write_text(want)
    if drift and args.apply:
        print("applied")
        return 0
    return 1 if drift else 0


if __name__ == "__main__":
    sys.exit(main())
