#!/usr/bin/env python3
"""Collect the complete uncommitted change of a repo into a bundle directory.

Usage: review-bundle <repo> [--show <path>]... [--baseline] [--base <rev>]
       review-bundle <repo> --classify [--paths <path>...] [--base <rev>]

--base <rev> diffs against <rev> instead of HEAD (default HEAD), e.g. to bundle
already-integrated commits. The rev is resolved once; a bad rev exits 2 before
anything is written. A baseline taken with --base is not comparable to one taken
without.

Writes section files under $OPENCODE_TMP/review-bundles/<name>-<stamp>/ and prints
the directory on success. Section files:
  00-status.txt      git status --short
  01-diffstat.txt    git diff --stat <base>   (default HEAD)
  02-diff-NN.txt     git diff <base>          (default HEAD)
  03-untracked-NN.txt the contents of every untracked, non-ignored, non-secret file
  04-show-NN.txt     the contents of each --show <path> at <base> (default HEAD)
  05-baseline.json   diff hash and untracked git hashes for a later delta re-review
  99-omitted.txt     binary, non-UTF-8, secret, and unreadable files, with reason and size

Large sections (diff, untracked, show) are split into at most CHUNK lines per
file, so a reviewer's 2000-line read cap is never hit. Nothing is cut except
secret paths, which are excluded from the diff and untracked contents and listed
in 99-omitted.txt.

--classify prints a tier floor instead of a bundle: line 1 is T1 or T2, then one
reason per line. It is a ratchet, not a verdict: the caller may raise the tier but
never lower it. It reads the current diff, or the planned files named by --paths
(no line count is known before the edit, so only the file rules apply there).
With --paths, --base is validated but ignored for classification.

After the reasons, --classify prints: with --paths, a `lines: not measured` note;
`critical: <path> — <token>` for each path critical_token() gives a token
(auth|security|migration|public-contract, first match in AGENTS.md order; never
.github/*); and, when the floor is T2, exactly one `prose-lane:` line
(candidate|eligible|ineligible — <reason>). Line 1, the floor, never changes.

Read-only: only `status`, `diff`, `ls-files`, `show`, `rev-parse`, and
`hash-object` run, with optional locks disabled. Nothing is staged and the index
is never written. A git failure aborts the run rather than emitting an empty
section.
"""

import datetime
import fnmatch
import hashlib
import json
import os
import re
import subprocess
import sys

CHUNK = 1500
LIMIT = 20 * 1024 * 1024
# OPENCODE_TMP wins; otherwise a per-user temp dir. TMPDIR is /var/folders/.../T on macOS
# and usually /tmp on Linux — the old literal was macOS-only and crashed on Linux with
# permission denied on /private. Resolve through /private/var on macOS is the same inode.
DEFAULT_TMP = os.path.join(os.environ.get("TMPDIR") or "/tmp", "opencode")

SECRET_NAMES = {
    "service.json",
    ".env",
    "auth.json",
    "credentials",
    "id_rsa",
    "id_ed25519",
}
SECRET_SUFFIXES = (".pem", ".key", ".p12", ".pfx")
SECRET_PATHSPECS = [
    ":(exclude,glob)**/service.json",
    ":(exclude,glob)**/.env",
    ":(exclude,glob)**/.env.*",
    ":(exclude,glob)**/auth.json",
    ":(exclude,glob)**/credentials",
    ":(exclude,glob)**/id_rsa",
    ":(exclude,glob)**/id_ed25519",
    ":(exclude,glob)**/*.pem",
    ":(exclude,glob)**/*.key",
    ":(exclude,glob)**/*.p12",
    ":(exclude,glob)**/*.pfx",
]


def is_secret(rel):
    name = os.path.basename(rel)
    if name == ".env.example":
        return False
    if name in SECRET_NAMES or name.startswith(".env."):
        return True
    return name.endswith(SECRET_SUFFIXES)


def git(repo, args, text=True):
    env = dict(os.environ)
    env["GIT_OPTIONAL_LOCKS"] = "0"
    kwargs = {"capture_output": True, "text": text, "env": env}
    if text:
        kwargs["errors"] = "replace"
    return subprocess.run(["git", "-C", repo, *args], **kwargs)


def git_ok(repo, args, text=True):
    """Run git; abort the bundle on a non-zero exit rather than drop evidence."""
    res = git(repo, args, text=text)
    if res.returncode != 0:
        detail = res.stderr if isinstance(res.stderr, str) else (res.stderr or b"")
        sys.stderr.write(f"git {' '.join(args)} failed (rc={res.returncode}): {detail}\n")
        sys.exit(4)
    return res


def chunks(lines):
    for i in range(0, len(lines), CHUNK):
        yield lines[i : i + CHUNK]


def write_parts(root, prefix, text):
    """Write text as <prefix>-NN.txt, one file per CHUNK lines. Returns bytes."""
    if text == "":
        text = "\n"
    lines = text.splitlines(keepends=True)
    if not lines:
        lines = ["\n"]
    total = 0
    for n, group in enumerate(chunks(lines)):
        body = "".join(group)
        path = os.path.join(root, f"{prefix}-{n:02d}.txt")
        data = body.encode("utf-8", "replace")
        with open(path, "wb") as fh:
            fh.write(data)
        total += len(data)
    return total


# T1 limits from AGENTS.md, plus the paths it names as always-T2.
T1_MAX_FILES = 3
T1_MAX_LINES = 400
ALWAYS = (
    ".github/*",
    "agents/*",
    "AGENTS.md",
    "policy/*",
    "memory/core/*",
    "*opencode.json",
    "*global.json",
)
# Anchored forms. The old `*schema*` / `*auth*` substrings flagged JSON-schema exporters
# and "Authoring". `auth[!o]` skips author/authoring/authority; authoriz*/authoris* keep
# authorization. `*auth` covers a bare name or directory ending in auth.
SCHEMA_PATTERNS = (
    "schema.*", "*/schema.*", "schema-*", "*/schema-*", "schema_*", "*/schema_*",
    "schema/*", "*/schema/*", "schemas/*", "*/schemas/*", "*dbschema*",
)
AUTH_PATTERNS = ("*auth", "*auth[!o]*", "*authoriz*", "*authoris*")
SOURCE_SENSITIVE = (
    "*.sql",
    "*migration*",
    *SCHEMA_PATTERNS,
    "*.csproj",
    "*.sln",
    "*.slnx",
    "*Dockerfile*",
    *AUTH_PATTERNS,
    "*secret*",
    "*credential*",
    "*.env*",
    "*permission*",
)
# The auth and secret variants of DOC_SENSITIVE, named so critical_token can reuse them.
DOC_AUTH_PATTERNS = (
    "*auth-*",
    "*auth.*",
    "*auth_*",
    "*/auth/*",
    "*auth.json",
    "*auth.toml",
    "*auth.yml",
    "*auth.yaml",
    "*authentication*",
    "*authorization*",
)
DOC_SECRET_PATTERNS = (
    "*secret-*",
    "*secret.*",
    "*secrets.*",
    "*secret_*",
    "*/secrets/*",
)
DOC_SENSITIVE = (
    "*.sql",
    "*migration*",
    *SCHEMA_PATTERNS,
    "*.csproj",
    "*.sln",
    "*.slnx",
    "*Dockerfile*",
    *DOC_AUTH_PATTERNS,
    *DOC_SECRET_PATTERNS,
    "*credential*",
    "*.env*",
    "*permission*",
)
# critical_token categories, in AGENTS.md order (Classify, trigger (c)).
SECURITY_PATTERNS = ("*secret*", "*credential*", "*.env*", "*permission*")
DOC_SECURITY_PATTERNS = (*DOC_SECRET_PATTERNS, "*credential*", "*.env*", "*permission*")
MIGRATION_PATTERNS = ("*migration*", *SCHEMA_PATTERNS, "*.sql")


def _is_doc(low):
    return low.endswith((".md", ".txt"))


def _matches(low, pats):
    return any(fnmatch.fnmatchcase(low, pat.lower()) for pat in pats)


def is_sensitive(rel):
    low = rel.lower()
    if _matches(low, ALWAYS):
        return True
    pats = DOC_SENSITIVE if _is_doc(low) else SOURCE_SENSITIVE
    return _matches(low, pats)


def critical_token(rel):
    """Critical-T2 token for a path, or None. First match wins, in AGENTS.md order:
    .github/* -> None (CI is never critical); auth; security; migration; any other
    sensitive path -> public-contract. Doc paths use the DOC_SENSITIVE variants, so
    a token is only ever given to a path is_sensitive flags."""
    low = rel.lower()
    if fnmatch.fnmatchcase(low, ".github/*") or not is_sensitive(rel):
        return None
    doc = _is_doc(low)
    if _matches(low, DOC_AUTH_PATTERNS if doc else AUTH_PATTERNS):
        return "auth"
    if _matches(low, DOC_SECURITY_PATTERNS if doc else SECURITY_PATTERNS):
        return "security"
    if _matches(low, MIGRATION_PATTERNS):
        return "migration"
    return "public-contract"


# Prose lane (agents/*.md bodies and some AGENTS.md sections): a T2 floor whose only
# reasons are prose paths may be eligible for a lighter lane. Line 1 never changes.
PROSE_AGENTS_SECTIONS = (
    "## Memory",
    "### Pull requests",
    "### Ledger",
    "### Manual overrides",
    "## C# / .NET work",
)
PROSE_BLOCKERS = (
    re.compile(r"\b(claude-agent|opencode-go|opencode|xai)/\S+"),
    re.compile(r"deny", re.IGNORECASE),
    re.compile(r"permission", re.IGNORECASE),
    re.compile(r"EXECUTE ALLOWLIST"),
    re.compile(r"PROMPT:"),
    re.compile(r"steps:"),
)
HUNK_RE = re.compile(r"^@@ -(\d+)(?:,(\d+))? \+(\d+)(?:,(\d+))? @@")


def is_prose_path(rel):
    return rel == "AGENTS.md" or fnmatch.fnmatchcase(rel, "agents/*.md")


def frontmatter_end(text):
    """Last line number (1-based) of a leading --- frontmatter block, or 0."""
    lines = text.splitlines()
    if not lines or lines[0].rstrip() != "---":
        return 0
    for i, line in enumerate(lines[1:], start=2):
        if line.rstrip() == "---":
            return i
    return len(lines)


def sections_by_line(text):
    """Map each 1-based line to the nearest markdown heading at or above it,
    ignoring headings inside fenced code blocks."""
    out, current, fence = [None], None, False
    for line in text.splitlines():
        stripped = line.rstrip()
        if stripped.lstrip().startswith(("```", "~~~")):
            fence = not fence
        elif not fence and re.match(r"#{1,6} ", stripped):
            current = stripped
        out.append(current)
    return out


def _read_new(repo, rel):
    try:
        with open(os.path.join(repo, rel), encoding="utf-8", errors="replace") as fh:
            return fh.read()
    except OSError:
        return ""


def _read_old(repo, ref, rel):
    res = git(repo, ["show", f"{ref}:{rel}"])
    return res.stdout if res.returncode == 0 else ""


def prose_lane(repo, info, planned, ref):
    """Return the prose-lane state line for a T2 floor: candidate, eligible or
    ineligible, each with a reason."""
    if info["other_reasons"]:
        return f"ineligible — {info['other_reasons'][0]}"
    blockers = [p for p in info["sensitive"] if not is_prose_path(p)]
    if blockers:
        return f"ineligible — {blockers[0]} is not an AGENTS.md or agents/*.md path"
    if planned:
        return "candidate — every T2 reason is an AGENTS.md or agents/*.md path; the diff decides eligibility"
    # (a) no file added, deleted or renamed; untracked files count as added.
    for row in (git_ok(repo, ["diff", "--name-status", "-M", ref]).stdout or "").splitlines():
        status = row.split("\t", 1)[0]
        if status[:1] in ("A", "D", "R", "C"):
            return f"ineligible — (a) {row.split(chr(9))[-1]} is added, deleted or renamed ({status})"
    if info["untracked"]:
        return f"ineligible — (a) {info['untracked'][0]} is added (untracked)"
    for rel in info["paths"]:
        diff = git_ok(repo, ["diff", "-U0", "--no-color", "--no-ext-diff", ref, "--", rel]).stdout or ""
        old_text, new_text = _read_old(repo, ref, rel), _read_new(repo, rel)
        old_fm, new_fm = frontmatter_end(old_text), frontmatter_end(new_text)
        new_sec = sections_by_line(new_text) if rel == "AGENTS.md" else None
        old_sec = sections_by_line(old_text) if rel == "AGENTS.md" else None
        for line in diff.splitlines():
            m = HUNK_RE.match(line)
            if m:
                o_start, o_len = int(m.group(1)), int(m.group(2) or "1")
                n_start, n_len = int(m.group(3)), int(m.group(4) or "1")
                # (b) the hunk touches the leading frontmatter, in either file.
                if (o_len and o_start <= old_fm) or (n_len and n_start <= new_fm) or (
                    not n_len and new_fm and n_start < new_fm
                ):
                    return f"ineligible — (b) {rel} hunk at line {n_start} touches the frontmatter"
                # (d) every AGENTS.md hunk must sit under an allowlisted section.
                if new_sec is not None:
                    news = range(n_start, n_start + n_len) if n_len else [n_start]
                    olds = range(o_start, o_start + o_len)
                    secs = [new_sec[i] if i < len(new_sec) else new_sec[-1] for i in news]
                    secs += [old_sec[i] if i < len(old_sec) else old_sec[-1] for i in olds]
                    for sec in secs:
                        if sec not in PROSE_AGENTS_SECTIONS:
                            return (
                                f"ineligible — (d) AGENTS.md hunk at line {n_start} is under "
                                f"{sec or 'no heading'}, not a prose-lane section"
                            )
                continue
            if line.startswith(("+++", "---")) or not line.startswith(("+", "-")):
                continue
            # (c) no added or removed line carries a pin, permission or control key.
            for pat in PROSE_BLOCKERS:
                hit = pat.search(line[1:])
                if hit:
                    return f"ineligible — (c) {rel} changes a line with {hit.group(0)!r}"
    return "eligible — body-only edit to existing AGENTS.md/agents/*.md prose"


def classify_detail(repo, planned, ref="HEAD"):
    """Return the classify facts: floor, reasons, paths, sensitive paths, the
    non-path reasons, and untracked paths."""
    lines = 0
    untracked = []
    if planned:
        paths = list(planned)
    else:
        paths = [
            p
            for p in (git_ok(repo, ["diff", "--name-only", ref]).stdout or "").splitlines()
            if p
        ]
        for row in (git_ok(repo, ["diff", "--numstat", ref]).stdout or "").splitlines():
            added, removed, _name = (row.split("\t") + ["", "", ""])[:3]
            lines += int(added) if added.isdigit() else 0
            lines += int(removed) if removed.isdigit() else 0
        listed = git_ok(repo, ["ls-files", "--others", "--exclude-standard", "-z"]).stdout or ""
        for rel in (p for p in listed.split("\0") if p):
            paths.append(rel)
            untracked.append(rel)
            try:
                with open(os.path.join(repo, rel), "rb") as fh:
                    lines += fh.read().count(b"\n")
            except OSError:
                pass
    other = []
    source = [p for p in paths if not p.lower().endswith((".md", ".txt"))]
    if len(source) > T1_MAX_FILES:
        other.append(f"{len(source)} non-doc files (T1 allows {T1_MAX_FILES})")
    if lines > T1_MAX_LINES:
        other.append(f"{lines} changed lines (T1 allows {T1_MAX_LINES})")
    sensitive = [rel for rel in paths if is_sensitive(rel)]
    reasons = other + [f"{rel} is a public-contract, security, data, or CI path" for rel in sensitive]
    return {
        "floor": "T2" if reasons else "T1",
        "reasons": reasons,
        "paths": paths,
        "sensitive": sensitive,
        "other_reasons": other,
        "untracked": untracked,
    }


def classify(repo, planned, ref="HEAD"):
    """Return (floor, reasons). T2 when any rule trips; otherwise T1."""
    info = classify_detail(repo, planned, ref)
    return info["floor"], info["reasons"]


def classify_lines(repo, planned, ref="HEAD"):
    """The --classify output: line 1 is the floor, then indented detail lines."""
    info = classify_detail(repo, planned, ref)
    out = [info["floor"]] + [f"  {r}" for r in info["reasons"]]
    if planned:
        out.append(
            f"  lines: not measured (planned paths); integrate --base applies the {T1_MAX_LINES}-line limit"
        )
    informational = False
    for rel in info["paths"]:
        token = critical_token(rel)
        if token:
            out.append(f"  critical: {rel} — {token}")
            informational |= token == "public-contract" and is_prose_path(rel)
    if informational:
        out.append(
            "  note: critical … public-contract for AGENTS.md/agents/*.md is informational "
            "on a T1 lane (it triggers review-critical only at T2)"
        )
    if info["floor"] == "T2":
        out.append(f"  prose-lane: {prose_lane(repo, info, planned, ref)}")
    return out


def is_binary(data):
    return b"\x00" in data[:8192]


def main(argv):
    if not argv:
        print("usage: review-bundle <repo> [--show <path>]... [--baseline] [--base <rev>] | --classify [--paths <path>...] [--base <rev>]", file=sys.stderr)
        return 2
    repo = os.path.abspath(argv[0])
    shows = []
    baseline = False
    base_rev = None
    classify_only = False
    planned = []
    rest = argv[1:]
    while rest:
        if rest[0] == "--classify":
            classify_only = True
            rest = rest[1:]
        elif rest[0] == "--paths":
            rest = rest[1:]
            while rest and not rest[0].startswith("--"):
                planned.append(rest[0])
                rest = rest[1:]
        elif rest[0] == "--show":
            if len(rest) < 2:
                print("--show needs a path", file=sys.stderr)
                return 2
            shows.append(rest[1])
            rest = rest[2:]
        elif rest[0] == "--base":
            if len(rest) < 2:
                print("--base needs a rev", file=sys.stderr)
                return 2
            base_rev = rest[1]
            rest = rest[2:]
        elif rest[0] == "--baseline":
            baseline = True
            rest = rest[1:]
        else:
            print(f"unknown argument: {rest[0]}", file=sys.stderr)
            return 2

    if git(repo, ["rev-parse", "--is-inside-work-tree"]).returncode != 0:
        print(f"not a git repo: {repo}", file=sys.stderr)
        return 2

    base_sha = None
    if base_rev is not None:
        res = git(repo, ["rev-parse", "--verify", f"{base_rev}^{{commit}}"])
        if res.returncode != 0 or not (res.stdout or "").strip():
            print(f"bad --base: {base_rev}", file=sys.stderr)
            return 2
        base_sha = res.stdout.strip()
    ref = base_sha or "HEAD"

    if classify_only:
        for line in classify_lines(repo, planned, ref):
            print(line)
        return 0

    stamp = datetime.datetime.now().strftime("%Y%m%d-%H%M%S")
    base = os.path.join(
        os.environ.get("OPENCODE_TMP", DEFAULT_TMP),
        "review-bundles",
        f"{os.path.basename(repo)}-{stamp}",
    )
    root, clash = base, 0
    while os.path.exists(root):
        clash += 1
        root = f"{base}-{clash}"
    os.makedirs(root)

    total = 0
    omitted = []

    status = git_ok(repo, ["status", "--short"]).stdout or ""
    with open(os.path.join(root, "00-status.txt"), "w") as fh:
        fh.write(status)

    diffstat = git_ok(repo, ["diff", "--stat", ref, "--", ".", *SECRET_PATHSPECS]).stdout or ""
    with open(os.path.join(root, "01-diffstat.txt"), "w") as fh:
        fh.write(diffstat)

    diff = git_ok(repo, ["diff", ref, "--", ".", *SECRET_PATHSPECS]).stdout or ""
    for rel in (git_ok(repo, ["diff", "--name-only", ref]).stdout or "").splitlines():
        if os.path.basename(rel) == ".env.example":
            omitted.append(f"{rel} (excluded by env glob; not secret)")
        elif is_secret(rel):
            omitted.append(f"{rel} (secret path; excluded from diff)")
    for line in diff.splitlines():
        if line.startswith("Binary files ") and line.endswith(" differ"):
            omitted.append(f"{line[len('Binary files '):-len(' differ')]} (binary, tracked)")
    total += write_parts(root, "02-diff", diff)

    listed = git_ok(repo, ["ls-files", "--others", "--exclude-standard", "-z"]).stdout or ""
    untracked = [p for p in listed.split("\0") if p]
    flat = []
    for rel in untracked:
        if is_secret(rel):
            omitted.append(f"{rel} (secret path; excluded)")
            continue
        path = os.path.join(repo, rel)
        if os.path.islink(path):
            omitted.append(f"{rel} (symlink; excluded)")
            continue
        try:
            with open(path, "rb") as fh:
                data = fh.read()
        except OSError as exc:
            omitted.append(f"{rel} (unreadable: {exc.strerror})")
            continue
        if is_binary(data):
            omitted.append(f"{rel} (binary, {len(data)} bytes)")
            continue
        try:
            body = data.decode("utf-8")
        except UnicodeDecodeError:
            omitted.append(f"{rel} (non-UTF-8; shown with replacement chars, {len(data)} bytes)")
            body = data.decode("utf-8", "replace")
        if body and not body.endswith("\n"):
            body += "\n"
        flat.append(f"### untracked: {rel} ({len(data)} bytes)\n")
        flat.extend(body.splitlines(keepends=True))
    if flat:
        total += write_parts(root, "03-untracked", "".join(flat))

    show_parts = []
    at = "base" if base_sha else "HEAD"
    for rel in shows:
        res = git(repo, ["show", f"{ref}:{rel}"], text=False)
        if res.returncode != 0 or res.stdout is None:
            show_parts.append(f"### show: {rel}\nabsent at {at}\n")
            continue
        data = res.stdout
        if is_binary(data):
            omitted.append(f"{rel} (binary baseline at {at}, {len(data)} bytes)")
            show_parts.append(f"### show: {rel}\nbinary at {at}; see 99-omitted.txt\n")
            continue
        try:
            text = data.decode("utf-8")
        except UnicodeDecodeError:
            omitted.append(
                f"{rel} (non-UTF-8 baseline; shown with replacement chars, {len(data)} bytes)"
            )
            text = data.decode("utf-8", "replace")
        if text and not text.endswith("\n"):
            text += "\n"
        show_parts.append(f"### show: {rel}\n{text}")
    if show_parts:
        total += write_parts(root, "04-show", "".join(show_parts))

    if baseline:
        untracked_hashes = []
        for rel in untracked:
            path = os.path.join(repo, rel)
            if is_secret(rel) or os.path.islink(path):
                continue
            result = git(repo, ["hash-object", "--", rel])
            if result.returncode == 0 and result.stdout:
                untracked_hashes.append({"path": rel, "git_hash": result.stdout.strip()})
            else:
                detail = result.stderr.strip() if isinstance(result.stderr, str) else ""
                untracked_hashes.append({"path": rel, "error": detail or "hash-object failed"})
        payload = {
            "head": git_ok(repo, ["rev-parse", "HEAD"]).stdout.strip(),
            "diff_sha256": hashlib.sha256(diff.encode("utf-8", "replace")).hexdigest(),
            "untracked": untracked_hashes,
            "timestamp": datetime.datetime.now(datetime.timezone.utc).isoformat(),
        }
        if base_sha:
            payload["base"] = base_sha
        path = os.path.join(root, "05-baseline.json")
        with open(path, "w") as fh:
            json.dump(payload, fh, indent=2)
            fh.write("\n")
        total += os.path.getsize(path)

    if omitted:
        path = os.path.join(root, "99-omitted.txt")
        with open(path, "w") as fh:
            fh.write("\n".join(omitted) + "\n")
        total += os.path.getsize(path)

    if total > LIMIT:
        print(root)
        print(
            f"bundle exceeds {LIMIT} bytes ({total}); review by slice instead",
            file=sys.stderr,
        )
        return 3

    print(root)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
