#!/bin/sh
# pr-settle: one-shot readiness check for a pull request.
#
# Usage: pr-settle <pr-number-or-url>
#
# Prints the checks, unresolved review-thread count and mergeability, then
# exits:
#   0  ready: green checks, zero unresolved review threads, mergeable
#   1  failing checks
#   2  pending checks
#   3  unresolved review threads (checks otherwise ok)
#   4  other blocker: conflicts, draft, merged/closed, not a PR, gh error
#
# This is a status snapshot, not a watch. Check it once, then use T3's
# watch_pull_request if a PR needs to settle. Do not poll with
# `gh pr checks --watch`, `gh run watch`, or sleep loops.
set -eu

usage() {
  cat <<'EOF'
usage: pr-settle <pr-number-or-url>

One-shot pull request readiness check. Exit codes:
  0 ready   1 failing checks   2 pending checks
  3 unresolved review threads  4 other blocker (conflicts, draft, merged,
  closed, not a PR, gh error)
EOF
}

case "${1:-}" in
  -h | --help)
    usage
    exit 0
    ;;
  "") usage >&2; exit 4 ;;
esac
if [ "$#" -gt 1 ]; then
  echo "pr-settle: too many arguments" >&2
  usage >&2
  exit 4
fi

arg=$1
repo=
case "$arg" in
  *github.com/*/pull/*)
    number=$(printf '%s\n' "$arg" | sed -n 's#.*/pull/\([0-9][0-9]*\).*#\1#p')
    repo=$(printf '%s\n' "$arg" | sed -n 's#.*github\.com/\([^/]*/[^/]*\)/pull/.*#\1#p')
    if [ -z "$number" ] || [ -z "$repo" ]; then
      echo "pr-settle: not a PR number or URL: $arg" >&2
      usage >&2
      exit 4
    fi
    ;;
  *[!0-9]*)
    echo "pr-settle: not a PR number or URL: $arg" >&2
    usage >&2
    exit 4
    ;;
  *) number=$arg ;;
esac

tmp=$(mktemp -d) || exit 4
trap 'rm -rf "$tmp"' EXIT
trap 'exit 4' HUP INT TERM

gh_err=$tmp/gh.err
if [ -n "$repo" ]; then
  set -- --repo "$repo"
else
  set --
fi

# One read, so a later gh failure cannot leak out as exit 1 under set -e.
if ! fields=$(gh pr view "$number" "$@" \
    --json state,isDraft,mergeable,mergeStateStatus,url \
    --jq '[.state, (.isDraft | tostring), .mergeable, .mergeStateStatus, .url] | @tsv' \
    2> "$gh_err"); then
  echo "pr-settle: cannot read PR $arg:" >&2
  sed 's/^/  /' "$gh_err" >&2
  exit 4
fi
tab=$(printf '\t')
IFS=$tab read -r state is_draft mergeable merge_state url <<EOF
$fields
EOF

printf 'pr-settle: %s %s\n' "$url" "$state"
printf '  mergeable: %s (%s)\n' "$mergeable" "$merge_state"

if [ "$state" != OPEN ]; then
  echo "pr-settle: blocker: PR is $state, nothing to settle"
  exit 4
fi
if [ "$is_draft" = true ]; then
  echo "pr-settle: blocker: PR is a draft"
  exit 4
fi
if [ "$mergeable" = CONFLICTING ] || [ "$merge_state" = DIRTY ]; then
  echo "pr-settle: blocker: merge conflicts"
  exit 4
fi
if [ "$mergeable" = UNKNOWN ]; then
  echo "pr-settle: blocker: mergeability unknown; GitHub has not computed it"
  exit 4
fi

# Checks: bucket values are pass, fail, pending, skipping, cancel. Treat
# skipping as fine and anything unknown as pending.
buckets=$(gh pr checks "$number" "$@" --json bucket --jq '.[].bucket' \
  2> "$gh_err") || true
if [ -z "$buckets" ] && [ -s "$gh_err" ] && ! grep -qi "no checks" "$gh_err"; then
  echo "pr-settle: cannot read checks:" >&2
  sed 's/^/  /' "$gh_err" >&2
  exit 4
fi

n_pass=0 n_fail=0 n_pending=0 n_other=0
for bucket in $buckets; do
  case "$bucket" in
    pass | skipping) n_pass=$((n_pass + 1)) ;;
    fail | cancel) n_fail=$((n_fail + 1)) ;;
    pending | "") n_pending=$((n_pending + 1)) ;;
    *) n_pending=$((n_pending + 1)); n_other=$((n_other + 1)) ;;
  esac
done
printf '  checks: %d pass, %d failing, %d pending' "$n_pass" "$n_fail" "$n_pending"
[ "$n_other" -eq 0 ] || printf ', %d other' "$n_other"
printf '\n'

# Review threads: count the unresolved ones across every page.
owner=$(printf '%s\n' "$url" | sed -n 's#.*github\.com/\([^/]*\)/.*#\1#p')
name=$(printf '%s\n' "$url" | sed -n 's#.*github\.com/[^/]*/\([^/]*\)/pull/.*#\1#p')
if [ -z "$owner" ] || [ -z "$name" ]; then
  echo "pr-settle: cannot parse repository from $url" >&2
  exit 4
fi
# $owner, $name, $number and $endCursor are GraphQL variables, not shell.
# shellcheck disable=SC2016
query='query($owner:String!,$name:String!,$number:Int!,$endCursor:String){
  repository(owner:$owner,name:$name){
    pullRequest(number:$number){
      reviewThreads(first:100,after:$endCursor){
        pageInfo{hasNextPage endCursor}
        nodes{isResolved}
      }
    }
  }
}'
if ! per_page=$(gh api graphql --paginate \
    -f query="$query" -f owner="$owner" -f name="$name" -F number="$number" \
    --jq '[.data.repository.pullRequest.reviewThreads.nodes[] | select(.isResolved == false)] | length' \
    2> "$gh_err"); then
  echo "pr-settle: cannot read review threads:" >&2
  sed 's/^/  /' "$gh_err" >&2
  exit 4
fi
unresolved=0
for page in $per_page; do
  unresolved=$((unresolved + page))
done
printf '  review threads: %d unresolved\n' "$unresolved"

if [ "$n_fail" -gt 0 ]; then
  echo "pr-settle: failing checks"
  exit 1
fi
if [ "$n_pending" -gt 0 ]; then
  echo "pr-settle: pending checks"
  exit 2
fi
if [ "$unresolved" -gt 0 ]; then
  echo "pr-settle: unresolved review threads"
  exit 3
fi
if [ "$mergeable" != MERGEABLE ]; then
  echo "pr-settle: blocker: mergeable is $mergeable"
  exit 4
fi
echo "pr-settle: ready"
exit 0
