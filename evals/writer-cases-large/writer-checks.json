{
  "large-numeric-builtins": {
    "check": "dotnet run --project Poly.Tests/Poly.Tests.csproj -- --treenode-filter '/*/*/NumericBuiltinParityTests/*' --no-ansi",
    "protect": [
      "Poly.Tests/DomainModeling/Lowering/NumericBuiltinParityTests.cs"
    ]
  },
  "large-create-entry-notify": {
    "check": "dotnet run --project Poly.Tests/Poly.Tests.csproj -- --treenode-filter '/*/*/CreateEntryNotificationParityTests/*' --no-ansi",
    "protect": [
      "Poly.Tests/DomainModeling/Lowering/CreateEntryNotificationParityTests.cs"
    ]
  },
  "large-interval-precision": {
    "check": "dotnet run --project Poly.Tests/Poly.Tests.csproj -- --treenode-filter '/*/*/UnverifiedWriteTests/*' --no-ansi && dotnet run --project Poly.Tests/Poly.Tests.csproj -- --treenode-filter '/*/*/VerificationSummaryTests/*' --no-ansi",
    "protect": [
      "Poly.Tests/DomainModeling/Analysis/UnverifiedWriteTests.cs",
      "Poly.Tests/DomainModeling/Analysis/VerificationSummaryTests.cs"
