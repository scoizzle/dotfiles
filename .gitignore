.DS_Store

# Orchestrator seat marker. Create it only in a dedicated seat worktree; an
# untracked, ignored file is absent from delegate_task worktrees (committed
# state only), so a delegated child never inherits the seat.
/.orchestrator-seat

# Machine-local state. opencode writes these into ~/.config/opencode itself;
# they hold a generated password / per-machine UI state and must not travel.
service.json
cli.json
reviews.jsonl

# Agent-written lessons. install.cs symlinks memory/ to
# ~/.config/opencode/memory/, so a dream writes these into this working tree.
# They stay on disk in the checkout and do not travel with git.
# README.md and .gitkeep stay tracked.
memory/learnings/*
!memory/learnings/README.md
!memory/learnings/.gitkeep

__pycache__/
*.py[cod]

# Generated eval output (re-runnable with evals/run.sh)
evals/canary-*/

# Build output: AOT publish candidates, stamps, locks.
# bin/ is deliberately NOT ignored yet — the Python tools are still tracked there and
# stay the live entry points until each C# replacement passes ./install.cs --oracle.
.build/
*.dSYM/
*.dbg
