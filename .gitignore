.DS_Store

# Machine-local state. opencode writes these into ~/.config/opencode itself;
# they hold a generated password / per-machine UI state and must not travel.
service.json
cli.json
reviews.jsonl

# Agent-written lessons. ~/.config/opencode/.memory is the sparse git clone of this
# repo (install.cs); ~/.config/opencode/memory is the symlink to .memory/memory, and
# dream writes into memory/learnings/ through it.
# Dated files (YYYY-MM-DD.md) travel with git; README.md and .gitkeep stay tracked.
# pending/ is force-added only on the memory/dream staging branch.
memory/learnings/*
!memory/learnings/README.md
!memory/learnings/.gitkeep
!memory/learnings/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9].md
memory/learnings/pending/
memory/learnings/working.md
memory/learnings/.working.lock
memory/learnings/.working-*.tmp

__pycache__/
*.py[cod]

# Generated eval output (re-runnable with evals/run.sh)
evals/canary-*/

# Build output: AOT publish candidates, stamps, locks.
# bin/ is deliberately NOT ignored yet — the Python tools are still tracked there and
# stay the live entry points until each C# replacement passes ./install.cs --oracle.
.build/
*.dSYM/
*.dbg
