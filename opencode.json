{
  "$schema": "https://opencode.ai/config.json",
  "model": "{file:~/.config/opencode/models/lead}",
  "default_agent": "build",
  "permissions": [
    { "action": "skill", "resource": "antigravity2.0", "effect": "deny" },
    { "action": "skill", "resource": "pre-ship-review", "effect": "deny" },
    { "action": "subagent", "resource": "*", "effect": "deny" },
    { "action": "external_directory", "resource": "*", "effect": "allow" }
  ],
  "agents": {
    "build": {
      "model": "{file:~/.config/opencode/models/lead}"
    },
    "implementor": {
      "model": "{file:~/.config/opencode/models/implementor}"
    },
    "general": {
      "model": "{file:~/.config/opencode/models/implementor}"
    },
    "plan": {
      "mode": "all",
      "model": "{file:~/.config/opencode/models/lead}"
    },
    "advisor": {
      "model": "{file:~/.config/opencode/models/advisor}"
    },
    "dream-drafter": {
      "model": "{file:~/.config/opencode/models/drafter}"
    },
    "review-deep": {
      "model": "{file:~/.config/opencode/models/reviewer}"
    }
  },
  "mcp": {
    "servers": {
      "roslynk": {
        "type": "local",
        "command": [
          "{env:HOME}/.dotnet/tools/roslynk",
          "stdio"
        ],
        "codemode": false
      }
    }
  }
}
