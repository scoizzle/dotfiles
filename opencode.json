{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/deepseek-v4.1-flash",
  "default_agent": "build",
  "permissions": [
    { "action": "skill", "resource": "antigravity2.0", "effect": "deny" },
    { "action": "skill", "resource": "pre-ship-review", "effect": "deny" },
    { "action": "shell", "resource": "*git push*", "effect": "ask" },
    { "action": "shell", "resource": "*git -* push*", "effect": "ask" },
    { "action": "shell", "resource": "*git push*--force*", "effect": "deny" },
    { "action": "shell", "resource": "*git -* push*--force*", "effect": "deny" },
    { "action": "shell", "resource": "*git push* -f*", "effect": "deny" },
    { "action": "shell", "resource": "*git -* push* -f*", "effect": "deny" },
    { "action": "shell", "resource": "*git push* +*", "effect": "deny" },
    { "action": "shell", "resource": "*git -* push* +*", "effect": "deny" },
    { "action": "shell", "resource": "*git push*--delete*", "effect": "deny" },
    { "action": "shell", "resource": "*git -* push*--delete*", "effect": "deny" },
    { "action": "shell", "resource": "*git push*--mirror*", "effect": "deny" },
    { "action": "shell", "resource": "*git -* push*--mirror*", "effect": "deny" },
    { "action": "shell", "resource": "*git reset*--hard*", "effect": "deny" },
    { "action": "shell", "resource": "*git -* reset*--hard*", "effect": "deny" },
    { "action": "shell", "resource": "*git clean*", "effect": "deny" },
    { "action": "shell", "resource": "*git -* clean*", "effect": "deny" },
    { "action": "shell", "resource": "*rm -rf*", "effect": "deny" },
    { "action": "shell", "resource": "*rm -fr*", "effect": "deny" },
    { "action": "shell", "resource": "*rm -r -f*", "effect": "deny" },
    { "action": "shell", "resource": "*rm -f -r*", "effect": "deny" },
    { "action": "shell", "resource": "*rm --recursive*", "effect": "deny" },
    { "action": "shell", "resource": "*sudo *", "effect": "deny" },
    { "action": "shell", "resource": "*find*-delete*", "effect": "deny" },
    { "action": "shell", "resource": "*xargs*rm -rf*", "effect": "deny" },
    { "action": "shell", "resource": "*xargs*rm -fr*", "effect": "deny" },
    { "action": "shell", "resource": "git restore*", "effect": "deny" },
    { "action": "shell", "resource": "*git restore*", "effect": "deny" },
    { "action": "shell", "resource": "*git -* restore*", "effect": "deny" },
    { "action": "shell", "resource": "*git checkout -- *", "effect": "deny" },
    { "action": "shell", "resource": "*git -* checkout -- *", "effect": "deny" },
    { "action": "shell", "resource": "*git branch -D*", "effect": "deny" },
    { "action": "shell", "resource": "*git -* branch -D*", "effect": "deny" },
    { "action": "shell", "resource": "*gh api*-X*DELETE*", "effect": "deny" },
    { "action": "shell", "resource": "*gh -* api*-X*DELETE*", "effect": "deny" },
    { "action": "shell", "resource": "*gh api*--method*DELETE*", "effect": "deny" },
    { "action": "shell", "resource": "*gh -* api*--method*DELETE*", "effect": "deny" },
    { "action": "shell", "resource": "*gh pr merge*", "effect": "deny" },
    { "action": "shell", "resource": "*gh -* pr merge*", "effect": "deny" },
    { "action": "shell", "resource": "*npm publish*", "effect": "deny" },
    { "action": "shell", "resource": "*npm -* publish*", "effect": "deny" },
    { "action": "shell", "resource": "*/.ssh/*", "effect": "deny" },
    { "action": "shell", "resource": "*~/.ssh*", "effect": "deny" },
    { "action": "read", "resource": "~/.ssh/*", "effect": "deny" },
    { "action": "shell", "resource": "*/.aws/*", "effect": "deny" },
    { "action": "shell", "resource": "*~/.aws*", "effect": "deny" },
    { "action": "read", "resource": "~/.aws/*", "effect": "deny" },
    { "action": "shell", "resource": "*/.gnupg/*", "effect": "deny" },
    { "action": "shell", "resource": "*~/.gnupg*", "effect": "deny" },
    { "action": "read", "resource": "~/.gnupg/*", "effect": "deny" },
    { "action": "shell", "resource": "*/.config/gh/*", "effect": "deny" },
    { "action": "shell", "resource": "*~/.config/gh*", "effect": "deny" },
    { "action": "read", "resource": "~/.config/gh/*", "effect": "deny" },
    { "action": "shell", "resource": "*/.netrc*", "effect": "deny" },
    { "action": "read", "resource": "~/.netrc", "effect": "deny" },
    { "action": "shell", "resource": "*/.claude/.credentials.json*", "effect": "deny" },
    { "action": "read", "resource": "~/.claude/.credentials.json", "effect": "deny" },
    { "action": "shell", "resource": "*/.claude.json*", "effect": "deny" },
    { "action": "read", "resource": "~/.claude.json", "effect": "deny" },
    { "action": "shell", "resource": "*/.grok/auth.json*", "effect": "deny" },
    { "action": "read", "resource": "~/.grok/auth.json", "effect": "deny" },
    { "action": "shell", "resource": "*/.grok/config.toml*", "effect": "deny" },
    { "action": "read", "resource": "~/.grok/config.toml", "effect": "deny" },
    { "action": "shell", "resource": "*/.local/share/opencode/auth.json*", "effect": "deny" },
    { "action": "read", "resource": "~/.local/share/opencode/auth.json", "effect": "deny" },
    { "action": "shell", "resource": "*/.t3/userdata/statev2*", "effect": "deny" },
    { "action": "read", "resource": "~/.t3/userdata/statev2*", "effect": "deny" },
    { "action": "shell", "resource": "*/.claude/*", "effect": "deny" },
    { "action": "shell", "resource": "*service.json*", "effect": "deny" },
    { "action": "read", "resource": "**/service.json", "effect": "deny" },
    { "action": "shell", "resource": "*auth.json*", "effect": "deny" },
    { "action": "read", "resource": "**/auth.json", "effect": "deny" },
    { "action": "shell", "resource": "*.netrc*", "effect": "deny" },
    { "action": "read", "resource": "**/.netrc", "effect": "deny" },
    { "action": "read", "resource": "**/.env", "effect": "deny" },
    { "action": "read", "resource": ".env", "effect": "deny" },
    { "action": "read", "resource": "**/.env.*", "effect": "deny" },
    { "action": "read", "resource": ".env.*", "effect": "deny" },
    { "action": "read", "resource": "~/.claude/*", "effect": "deny" },
    { "action": "read", "resource": "~/.grok/*", "effect": "deny" },
    { "action": "read", "resource": "~/.cursor/*", "effect": "deny" },
    { "action": "read", "resource": "~/.copilot/*", "effect": "deny" },
    { "action": "read", "resource": "**/.env.example", "effect": "allow" },
    { "action": "read", "resource": ".env.example", "effect": "allow" },
    { "action": "edit", "resource": "memory/core/*", "effect": "deny" },
    { "action": "edit", "resource": "*/memory/core/*", "effect": "deny" }
  ],
  "agents": {
    "build": {
      "model": "opencode-go/deepseek-v4.1-flash#high"
    },
    "implementor": {
      "model": "opencode-go/deepseek-v4.1-flash#high"
    },
    "general": {
      "model": "opencode-go/deepseek-v4.1-flash#high"
    },
    "plan": {
      "mode": "all",
      "model": "opencode-go/deepseek-v4.1-flash#high"
    },
    "explore": {
      "description": "Cheap read-only swarm for repo maps, grep, and parallel search. Use for every broad read-only lookup. Never use for plan-lock, a repeated-error consult, or sign-off.",
      "model": "opencode-go/mimo-v2.6-flash",
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "deny" }
      ]
    }
  },
  "mcp": {
    "servers": {
      "roslynk": {
        "type": "local",
        "command": [
          "{env:HOME}/.dotnet/tools/roslynk",
          "stdio"
        ],
        "codemode": false
      }
    }
  }
}
