{
  "version": 1,
  "doc": "Single source for the permission policy of every harness (opencode, Claude Code, Grok Build). bin/sync-harness renders it; bin/harness-guard enforces it; bin/lint-config proves they agree on policy/vectors.json.",
  "shell": {
    "ask": [
      {
        "id": "git-push",
        "git": "push",
        "opencode": [
          "*git push*",
          "*git -* push*"
        ],
        "native": [
          "Bash(git push:*)"
        ]
      },
      {
        "id": "git-worktree-remove",
        "git": "worktree",
        "subargs": [
          "remove"
        ],
        "opencode": [
          "*git worktree remove*",
          "*git -* worktree remove*"
        ],
        "native": [
          "Bash(git worktree remove:*)"
        ],
        "skip_agents": [
          "verifier"
        ]
      }
    ],
    "deny": [
      {
        "id": "git-push-destructive",
        "git": "push",
        "flags": [
          "--force",
          "--force-with-lease",
          "--force-if-includes",
          "--delete",
          "--mirror",
          "--prune"
        ],
        "short": "fd",
        "refspec": true,
        "opencode": [
          "*git push*--force*",
          "*git -* push*--force*",
          "*git push* -f*",
          "*git -* push* -f*",
          "*git push* +*",
          "*git -* push* +*",
          "*git push*--delete*",
          "*git -* push*--delete*",
          "*git push*--mirror*",
          "*git -* push*--mirror*",
          "*git push* :*",
          "*git push* ':*",
          "*git -* push* :*",
          "*git -* push* ':*"
        ],
        "native": [
          "Bash(git push --force:*)",
          "Bash(git push -f:*)",
          "Bash(git push --delete:*)",
          "Bash(git push --mirror:*)",
          "Bash(git push * --force*)",
          "Bash(git push * -f*)",
          "Bash(git push * +*)",
          "Bash(git push * --delete*)",
          "Bash(git push * --mirror*)"
        ]
      },
      {
        "id": "git-reset-hard",
        "git": "reset",
        "flags": [
          "--hard"
        ],
        "opencode": [
          "*git reset*--hard*",
          "*git -* reset*--hard*"
        ],
        "native": [
          "Bash(git reset --hard:*)",
          "Bash(git reset * --hard*)"
        ]
      },
      {
        "id": "git-clean",
        "git": "clean",
        "opencode": [
          "*git clean*",
          "*git -* clean*"
        ],
        "native": [
          "Bash(git clean:*)"
        ]
      },
      {
        "id": "git-stash-drop",
        "git": "stash",
        "subargs": [
          "drop",
          "clear",
          "pop"
        ],
        "opencode": [
          "*git stash drop*",
          "*git stash clear*",
          "*git stash pop*",
          "*git -* stash drop*",
          "*git -* stash clear*",
          "*git -* stash pop*"
        ],
        "native": [
          "Bash(git stash drop:*)",
          "Bash(git stash clear:*)",
          "Bash(git stash pop:*)"
        ]
      },
      {
        "id": "rm-recursive-force",
        "program": "rm",
        "all_of": [
          {
            "short": "rR",
            "long": [
              "--recursive"
            ]
          },
          {
            "short": "f",
            "long": [
              "--force"
            ]
          }
        ],
        "opencode": [
          "*rm -rf*",
          "*rm -fr*",
          "*rm -r -f*",
          "*rm -f -r*",
          "*rm --recursive*"
        ],
        "native": [
          "Bash(rm -rf:*)",
          "Bash(rm -fr:*)",
          "Bash(rm -r -f:*)",
          "Bash(rm -f -r:*)",
          "Bash(rm --recursive:*)"
        ]
      },
      {
        "id": "privilege-escalation",
        "program": [
          "sudo",
          "doas"
        ],
        "opencode": [
          "*sudo *"
        ],
        "native": [
          "Bash(sudo:*)",
          "Bash(doas:*)"
        ]
      },
      {
        "id": "find-delete",
        "program": "find",
        "tokens": [
          "-delete"
        ],
        "opencode": [
          "*find*-delete*"
        ],
        "native": [
          "Bash(find * -delete*)",
          "Bash(find -delete:*)"
        ]
      },
      {
        "id": "xargs-remove",
        "program": "xargs",
        "after": "rm",
        "all_of": [
          {
            "short": "rR",
            "long": [
              "--recursive"
            ]
          },
          {
            "short": "f",
            "long": [
              "--force"
            ]
          }
        ],
        "opencode": [
          "*xargs*rm -rf*",
          "*xargs*rm -fr*"
        ],
        "native": [
          "Bash(xargs * rm -rf*)",
          "Bash(xargs * rm -fr*)"
        ]
      },
      {
        "id": "git-restore",
        "git": "restore",
        "opencode": [
          "git restore*",
          "*git restore*",
          "*git -* restore*"
        ],
        "native": [
          "Bash(git restore:*)"
        ]
      },
      {
        "id": "git-checkout-pathspec",
        "git": "checkout",
        "pathspec": true,
        "opencode": [
          "*git checkout -- *",
          "*git -* checkout -- *"
        ],
        "native": [
          "Bash(git checkout --:*)"
        ]
      },
      {
        "id": "git-branch-force-delete",
        "git": "branch",
        "short": "D",
        "opencode": [
          "*git branch -D*",
          "*git -* branch -D*"
        ],
        "native": [
          "Bash(git branch -D:*)"
        ]
      },
      {
        "id": "gh-api-delete",
        "program": "gh",
        "value_flags": [
          "-R",
          "--repo",
          "--hostname"
        ],
        "leading": [
          "api"
        ],
        "tokens": [
          "-X",
          "DELETE"
        ],
        "opencode": [
          "*gh api*-X*DELETE*",
          "*gh -* api*-X*DELETE*"
        ],
        "native": [
          "Bash(gh api -X DELETE:*)"
        ]
      },
      {
        "id": "gh-api-delete-long",
        "program": "gh",
        "value_flags": [
          "-R",
          "--repo",
          "--hostname"
        ],
        "leading": [
          "api"
        ],
        "tokens": [
          "--method",
          "DELETE"
        ],
        "opencode": [
          "*gh api*--method*DELETE*",
          "*gh -* api*--method*DELETE*"
        ],
        "native": [
          "Bash(gh api --method DELETE:*)"
        ]
      },
      {
        "id": "gh-pr-merge",
        "program": "gh",
        "value_flags": [
          "-R",
          "--repo",
          "--hostname"
        ],
        "leading": [
          "pr",
          "merge"
        ],
        "opencode": [
          "*gh pr merge*",
          "*gh -* pr merge*"
        ],
        "native": [
          "Bash(gh pr merge:*)"
        ]
      },
      {
        "id": "npm-publish",
        "program": "npm",
        "tokens": [
          "publish"
        ],
        "opencode": [
          "*npm publish*",
          "*npm -* publish*"
        ],
        "native": [
          "Bash(npm publish:*)"
        ]
      }
    ]
  },
  "protected": {
    "doc": "Credential stores. A trailing slash is a directory. Never listed: a harness's own working state (for example ~/.claude/projects), which that harness must be able to read.",
    "paths": [
      "~/.ssh/",
      "~/.aws/",
      "~/.gnupg/",
      "~/.config/gh/",
      "~/.config/bot-webhooks/",
      "~/.netrc",
      "~/.claude/.credentials.json",
      "~/.claude.json",
      "~/.grok/auth.json",
      "~/.grok/config.toml",
      "~/.local/share/opencode/auth.json",
      "~/.t3/userdata/statev2*"
    ],
    "names": [
      "service.json",
      "auth.json",
      ".netrc"
    ],
    "name_globs": [
      ".env",
      ".env.*"
    ],
    "name_allow": [
      ".env.example"
    ],
    "native_env_files": [
      ".env",
      ".env.local",
      ".env.development",
      ".env.production",
      ".env.test",
      ".env.staging"
    ]
  },
  "control_plane": {
    "doc": "Live harness configuration. install.cs links these installed paths into one checkout, so an edit through any of them is live for every session at once, before any review. bin/harness-guard asks on a resolved real path, which catches the checkout wherever it lives; bin/sync-harness renders the same paths as edit rules for opencode, which has no hook. A trailing slash is a directory.",
    "installed": [
      "~/.config/opencode/AGENTS.md",
      "~/.config/opencode/opencode.json",
      "~/.config/opencode/bin/",
      "~/.config/opencode/policy/",
      "~/.config/opencode/agents/",
      "~/.config/opencode/plugins/",
      "~/.claude/CLAUDE.md",
      "~/.claude/settings.json",
      "~/.local/bin/notify-bot",
      "~/.grok/AGENTS.md"
    ],
    "checkouts": [
      "~/dotfiles"
    ],
    "repo_paths": [
      "AGENTS.md",
      "opencode.json",
      "bin/",
      "policy/",
      "agents/",
      "plugins/"
    ]
  },
  "sandbox": {
    "doc": "Opt-in Claude Code Bash-sandbox profile, rendered by bin/sync-harness. Only shell commands run inside it; the file and web tools, MCP servers and hooks do not. Preview with --scope sandbox; apply to ~/.claude/settings.json with --scope home --apply --sandbox. A plain --apply never adds, changes or removes it. Every protected.paths entry is denied for reads: plain paths through credentials.files, wildcard entries through filesystem.denyRead. excluded_commands need the credential stores the sandbox hides, so they run outside it and still pass the permission rules and the guard. allow_write is deliberately narrow: ~/.dotnet is excluded because ~/.dotnet/tools holds global tools such as the roslynk MCP server, and MCP servers run outside the sandbox, so a sandboxed command that could write there could replace a binary that later runs unsandboxed. bin/lint-config fails on an allow_write entry that equals, contains or sits inside a location that runs or is loaded outside the sandbox. The lists are a starting profile: expect to add write paths and domains for a real build.",
    "allow_write": [
      "~/.nuget/packages",
      "~/.local/share/NuGet"
    ],
    "allowed_domains": [
      "github.com",
      "*.github.com",
      "*.githubusercontent.com",
      "api.nuget.org",
      "*.nuget.org",
      "registry.npmjs.org"
    ],
    "env_vars": [
      "GH_TOKEN",
      "GITHUB_TOKEN",
      "NPM_TOKEN",
      "NUGET_API_KEY",
      "ANTHROPIC_API_KEY",
      "OPENAI_API_KEY",
      "XAI_API_KEY",
      "DEEPSEEK_API_KEY",
      "AWS_ACCESS_KEY_ID",
      "AWS_SECRET_ACCESS_KEY",
      "AWS_SESSION_TOKEN"
    ],
    "excluded_commands": [
      "gh *",
      "git push *",
      "git fetch *",
      "git pull *",
      "notify-bot *",
      "~/.local/bin/notify-bot *",
      "$HOME/.local/bin/notify-bot *"
    ]
  },
  "no_edit": [
    "memory/core"
  ],
  "opencode": {
    "skill_deny": [
      "antigravity2.0",
      "pre-ship-review"
    ],
    "read_deny_extra": [
      "~/.claude/*",
      "~/.grok/*",
      "~/.cursor/*",
      "~/.copilot/*"
    ],
    "shell_deny_extra": [
      "*/.claude/*"
    ]
  },
  "readonly_agents": {
    "doc": "Read-only agents that must never write: the reviewers, the advisor and the explore swarm. agents/<name>.md is the source; bin/sync-harness renders each into ~/.claude/agents/<name>.md (Claude Code format, which Grok Build also reads) with only these tools. Models are the native fallback; the band pin in AGENTS.md applies when the agent runs as a T3 child. reload_solution is deliberately not listed: roslynk-rules allows it only on an explicit user request, which a read-only agent never has.",
    "tools": [
      "Read",
      "Grep",
      "Glob"
    ],
    "roslynk_read_tools": [
      "get_solution_status",
      "get_diagnostics",
      "get_symbol",
      "get_symbol_body",
      "get_members",
      "search_symbols",
      "find_definition",
      "get_expression_info",
      "find_references",
      "find_reads",
      "find_writes",
      "get_callers",
      "get_callees",
      "find_implementations",
      "get_type_hierarchy",
      "find_dead_code",
      "find_dead_conditionals",
      "multi_query",
      "get_code_actions",
      "open_solution"
    ],
    "models": {
      "review-deep": "opus",
      "advisor": "opus",
      "explore": "haiku"
    }
  },
  "native_agents": {
    "doc": "Agents rendered for the native harnesses beside readonly_agents. Claude Code loads them from ~/.claude/agents; Grok Build reads that directory through its Claude compatibility layer. `build` is deliberately absent: a rendered build is a dispatchable writer, which AGENTS.md forbids, and a native main session already gets its rules from the worktree's AGENTS.md. A null model or tools means the harness default, so implementor inherits the session model; verifier keeps the opencode sonnet pin and an explicit allowlist that mirrors its opencode denies (no edit, no subagent, no web) plus the Roslynk read tools. Every native agent also gets `disallowedTools` derived from its source agent's denies, so implementor loses Task/Agent/WebFetch/WebSearch while still inheriting Bash and edit. implementor is a dispatchable writer on purpose: it is the one bounded task agent; build is not. Bash stays in verifier's list, so its git boundary is the prompt, not the allowlist: Claude Code agent frontmatter has no per-command permission rules.",
    "agents": {
      "implementor": {
        "model": null,
        "tools": null
      },
      "verifier": {
        "model": "sonnet",
        "tools": [
          "Bash",
          "Read",
          "Grep",
          "Glob",
          "Skill"
        ]
      }
    }
  }
}
