{
  "version": 1,
  "doc": "Single source for the permission policy of opencode (v2 runs opencode only). bin/sync-harness renders it; bin/harness-guard enforces it; bin/lint-config proves they agree on policy/vectors.json.",
  "shell": {
    "ask": [
      {
        "id": "git-push",
        "git": "push",
        "opencode": [
          "*git push*",
          "*git -* push*"
        ]
      },
      {
        "id": "git-worktree-remove",
        "git": "worktree",
        "subargs": [
          "remove"
        ],
        "opencode": [
          "*git worktree remove*",
          "*git -* worktree remove*"
        ],
        "skip_agents": [
          "verifier"
        ]
      }
    ],
    "deny": [
      {
        "id": "git-push-destructive",
        "git": "push",
        "flags": [
          "--force",
          "--force-with-lease",
          "--force-if-includes",
          "--delete",
          "--mirror",
          "--prune"
        ],
        "short": "fd",
        "refspec": true,
        "opencode": [
          "*git push*--force*",
          "*git -* push*--force*",
          "*git push* -f*",
          "*git -* push* -f*",
          "*git push* +*",
          "*git -* push* +*",
          "*git push*--delete*",
          "*git -* push*--delete*",
          "*git push*--mirror*",
          "*git -* push*--mirror*",
          "*git push* :*",
          "*git push* ':*",
          "*git -* push* :*",
          "*git -* push* ':*"
        ]
      },
      {
        "id": "git-reset-hard",
        "git": "reset",
        "flags": [
          "--hard"
        ],
        "opencode": [
          "*git reset*--hard*",
          "*git -* reset*--hard*"
        ]
      },
      {
        "id": "git-clean",
        "git": "clean",
        "opencode": [
          "*git clean*",
          "*git -* clean*"
        ]
      },
      {
        "id": "git-stash-drop",
        "git": "stash",
        "subargs": [
          "drop",
          "clear",
          "pop"
        ],
        "opencode": [
          "*git stash drop*",
          "*git stash clear*",
          "*git stash pop*",
          "*git -* stash drop*",
          "*git -* stash clear*",
          "*git -* stash pop*"
        ]
      },
      {
        "id": "rm-recursive-force",
        "program": "rm",
        "all_of": [
          {
            "short": "rR",
            "long": [
              "--recursive"
            ]
          },
          {
            "short": "f",
            "long": [
              "--force"
            ]
          }
        ],
        "opencode": [
          "*rm -rf*",
          "*rm -fr*",
          "*rm -r -f*",
          "*rm -f -r*",
          "*rm --recursive*"
        ]
      },
      {
        "id": "privilege-escalation",
        "program": [
          "sudo",
          "doas"
        ],
        "opencode": [
          "*sudo *"
        ]
      },
      {
        "id": "find-delete",
        "program": "find",
        "tokens": [
          "-delete"
        ],
        "opencode": [
          "*find*-delete*"
        ]
      },
      {
        "id": "xargs-remove",
        "program": "xargs",
        "after": "rm",
        "all_of": [
          {
            "short": "rR",
            "long": [
              "--recursive"
            ]
          },
          {
            "short": "f",
            "long": [
              "--force"
            ]
          }
        ],
        "opencode": [
          "*xargs*rm -rf*",
          "*xargs*rm -fr*"
        ]
      },
      {
        "id": "git-restore",
        "git": "restore",
        "opencode": [
          "git restore*",
          "*git restore*",
          "*git -* restore*"
        ]
      },
      {
        "id": "git-checkout-pathspec",
        "git": "checkout",
        "pathspec": true,
        "opencode": [
          "*git checkout -- *",
          "*git -* checkout -- *"
        ]
      },
      {
        "id": "git-branch-force-delete",
        "git": "branch",
        "short": "D",
        "opencode": [
          "*git branch -D*",
          "*git -* branch -D*"
        ]
      },
      {
        "id": "gh-api-delete",
        "program": "gh",
        "value_flags": [
          "-R",
          "--repo",
          "--hostname"
        ],
        "leading": [
          "api"
        ],
        "tokens": [
          "-X",
          "DELETE"
        ],
        "opencode": [
          "*gh api*-X*DELETE*",
          "*gh -* api*-X*DELETE*"
        ]
      },
      {
        "id": "gh-api-delete-long",
        "program": "gh",
        "value_flags": [
          "-R",
          "--repo",
          "--hostname"
        ],
        "leading": [
          "api"
        ],
        "tokens": [
          "--method",
          "DELETE"
        ],
        "opencode": [
          "*gh api*--method*DELETE*",
          "*gh -* api*--method*DELETE*"
        ]
      },
      {
        "id": "gh-pr-merge",
        "program": "gh",
        "value_flags": [
          "-R",
          "--repo",
          "--hostname"
        ],
        "leading": [
          "pr",
          "merge"
        ],
        "opencode": [
          "*gh pr merge*",
          "*gh -* pr merge*"
        ]
      },
      {
        "id": "gh-api-merge",
        "doc": "the REST route to the merge gh-pr-merge denies; reading a PR through gh api stays allowed",
        "program": "gh",
        "leading": [
          "api"
        ],
        "matches": "(^|/)pulls/[^/?#]+/merge(?:[/?#]|$)",
        "opencode": [
          "*gh api*pulls/*/merge*"
        ]
      },
      {
        "id": "gh-api-graphql-merge",
        "doc": "the GraphQL route to the same merge (mergePullRequest, enablePullRequestAutoMerge); lifted with self-merge in v2.1",
        "program": "gh",
        "leading": [
          "api"
        ],
        "matches": "mergePullRequest|enablePullRequestAutoMerge",
        "opencode": [
          "*gh api*mergePullRequest*",
          "*gh api*enablePullRequestAutoMerge*"
        ]
      },
      {
        "id": "npm-publish",
        "program": "npm",
        "tokens": [
          "publish"
        ],
        "opencode": [
          "*npm publish*",
          "*npm -* publish*"
        ]
      }
    ]
  },
  "protected": {
    "doc": "Credential stores. A trailing slash is a directory. Never listed: a harness's own working state (for example ~/.claude/projects), which that harness must be able to read.",
    "paths": [
      "~/.ssh/",
      "~/.aws/",
      "~/.gnupg/",
      "~/.config/gh/",
      "~/.config/bot-webhooks/",
      "~/.netrc",
      "~/.claude/.credentials.json",
      "~/.claude.json",
      "~/.grok/auth.json",
      "~/.grok/config.toml",
      "~/.local/share/opencode/auth.json",
      "~/.t3/userdata/statev2*"
    ],
    "names": [
      "service.json",
      "auth.json",
      ".netrc"
    ],
    "name_globs": [
      ".env",
      ".env.*"
    ],
    "name_allow": [
      ".env.example"
    ]
  },
  "control_plane": {
    "doc": "Live harness configuration. install.cs links these installed paths into one checkout, so an edit through any of them is live for every session at once, before any review. bin/harness-guard asks on a resolved real path, which catches the checkout wherever it lives; bin/sync-harness renders the same paths as edit rules for opencode, which has no hook. A trailing slash is a directory. A link install.cs no longer creates (~/.claude/CLAUDE.md, ~/.grok/AGENTS.md) stays listed while it may still exist on a machine: it still points into the checkout, so an edit through it is live.",
    "installed": [
      "~/.config/opencode/AGENTS.md",
      "~/.config/opencode/opencode.json",
      "~/.config/opencode/bin/",
      "~/.config/opencode/policy/",
      "~/.config/opencode/agents/",
      "~/.config/opencode/plugins/",
      "~/.claude/CLAUDE.md",
      "~/.claude/settings.json",
      "~/.local/bin/notify-bot",
      "~/.grok/AGENTS.md",
      "~/.config/opencode/models.local.json",
      "~/.config/opencode/models/"
    ],
    "checkouts": [
      "~/dotfiles"
    ],
    "repo_paths": [
      "AGENTS.md",
      "opencode.json",
      "bin/",
      "policy/",
      "agents/",
      "plugins/",
      "models/"
    ]
  },
  "no_edit": [
    "memory/core"
  ],
  "opencode": {
    "doc": "tool_deny: opencode tools denied for every agent. subagent: all agent orchestration goes through T3 delegate_task (the person, 2026-11-22), so opencode's own dispatch is off and plain opencode has none.",
    "tool_deny": [
      "subagent"
    ],
    "skill_deny": [
      "antigravity2.0",
      "pre-ship-review"
    ],
    "read_deny_extra": [
      "~/.claude/*",
      "~/.grok/*",
      "~/.cursor/*",
      "~/.copilot/*"
    ],
    "shell_deny_extra": [
      "*/.claude/*"
    ]
  },
  "roles": {
    "doc": "Enforced by plugins/harness-guard.js in every opencode session (a T3 child runs as build, so agent frontmatter cannot limit it; the person, 2026-11-22). A session's role is the first line `role: <name>` in its first user message, stored per session the first time it is seen and never relaxed. A T3 child (its first message starts with T3's header) without a role line gets child_default; an unknown role gets unknown_role. allow and deny are action globs (opencode permission actions; MCP tools are <server>_<tool>); deny wins, and an action not allowed is denied. In a role session an ask becomes a deny: the child returns needs-answer instead. Code Mode `execute` is never evaluated itself, only the tools it calls, so its `fetch` is not covered.",
    "read_only": [
      "read",
      "grep",
      "glob",
      "skill",
      "todowrite",
      "roslynk_find_dead_code",
      "roslynk_find_dead_conditionals",
      "roslynk_find_definition",
      "roslynk_find_implementations",
      "roslynk_find_reads",
      "roslynk_find_references",
      "roslynk_find_writes",
      "roslynk_get_callees",
      "roslynk_get_callers",
      "roslynk_get_code_actions",
      "roslynk_get_diagnostics",
      "roslynk_get_expression_info",
      "roslynk_get_members",
      "roslynk_get_solution_status",
      "roslynk_get_symbol",
      "roslynk_get_symbol_body",
      "roslynk_get_type_hierarchy",
      "roslynk_multi_query",
      "roslynk_open_solution",
      "roslynk_search_symbols",
      "t3-code-*_ci_logs",
      "t3-code-*_t3_thread_read",
      "t3-code-*_pull_request_read",
      "t3-code-*_pull_request_list",
      "t3-code-*_list_thread_pull_requests",
      "t3-code-*_read_pull_request_guide",
      "t3-code-*_read_issue",
      "t3-code-*_list_issues",
      "t3-code-*_list_thread_issues",
      "t3-code-*_t3_worktree_status",
      "t3-code-*_t3_worktree_list"
    ],
    "unknown_role": "reviewer",
    "child_default": "reviewer",
    "roles": {
      "reviewer": {
        "allow": [
          "@read_only"
        ]
      },
      "advisor": {
        "allow": [
          "@read_only"
        ]
      },
      "explore": {
        "allow": [
          "@read_only",
          "webfetch",
          "websearch"
        ]
      },
      "verifier": {
        "allow": [
          "@read_only",
          "shell"
        ]
      },
      "implementor": {
        "allow": [
          "*"
        ],
        "deny": [
          "t3-code-*",
          "webfetch",
          "websearch",
          "question"
        ]
      }
    }
  }
}
